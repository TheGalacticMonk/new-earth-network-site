---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
---

<BaseLayout title="About" description="What New Earth Network is, and why it exists.">
  <Section>
    <Container narrow>
      <h1>What is New Earth Network</h1>
      <p class="lead">
        New Earth Network is a real-world community for people who found each other online
        and are ready to meet in person — built around recurring, local, in-person gatherings.
      </p>
      <p class="note">The full story, values, and history of New Earth Network are coming to this page next.</p>
    </Container>
  </Section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
  }

  .lead {
    margin-top: var(--space-8);
    font-size: var(--text-md);
    color: var(--color-text-body);
  }

  .note {
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
