---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="Docs & Films"
  description="Documentation, guides, and films from New Earth Network."
>
  <Section>
    <Container narrow>
      <h1>Docs & Films</h1>

      <div class="group">
        <h2>Docs</h2>
        <p class="lead">
          Guides and documentation for organizers and members are being written.
        </p>
        <p class="note">Coming soon.</p>
      </div>

      <div class="group">
        <h2>Films</h2>
        <p class="lead">
          A collection of films from the New Earth Network community is on its way.
        </p>
        <p class="note">Coming soon.</p>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
  }

  .group {
    margin-top: var(--space-16);
  }

  .group:first-of-type {
    margin-top: var(--space-8);
  }

  h2 {
    font-size: var(--text-lg);
  }

  .lead {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-text-body);
  }

  .note {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
