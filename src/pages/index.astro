---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Offerings from '../components/home/Offerings.astro';
import Manifesto from '../components/home/Manifesto.astro';
import UpcomingGatherings from '../components/home/UpcomingGatherings.astro';
import FindYourCity from '../components/home/FindYourCity.astro';
import WhatHappens from '../components/home/WhatHappens.astro';
import StartGathering from '../components/home/StartGathering.astro';
import CommunityProof from '../components/home/CommunityProof.astro';
import EmailSignup from '../components/home/EmailSignup.astro';

const stars = [
  { id: 'star-1', position: 'center', delay: '0.3s' },
  { id: 'star-2', position: 'inner-east', delay: '0s' },
  { id: 'star-3', position: 'inner-northeast', delay: '0.6s' },
  { id: 'star-4', position: 'inner-northwest', delay: '1.3s' },
  { id: 'star-5', position: 'inner-west', delay: '0.9s' },
  { id: 'star-6', position: 'inner-southwest', delay: '1.6s' },
  { id: 'star-7', position: 'inner-southeast', delay: '1.1s' },
  { id: 'star-8', position: 'outer-east', delay: '0.4s' },
  { id: 'star-9', position: 'outer-northeast', delay: '1.8s' },
  { id: 'star-10', position: 'outer-northwest', delay: '0.7s' },
  { id: 'star-11', position: 'outer-west', delay: '1.4s' },
  { id: 'star-12', position: 'outer-southwest', delay: '0.2s' },
  { id: 'star-13', position: 'outer-southeast', delay: '1.2s' },
  { id: 'star-14', position: 'halo-east', delay: '0.5s' },
  { id: 'star-15', position: 'halo-northeast', delay: '1.7s' },
  { id: 'star-16', position: 'halo-northwest', delay: '0.8s' },
  { id: 'star-17', position: 'halo-west', delay: '2.2s' },
  { id: 'star-18', position: 'halo-southwest', delay: '1s' },
  { id: 'star-19', position: 'halo-southeast', delay: '1.5s' },
  { id: 'star-20', position: 'edge-left-1', delay: '0.4s' },
  { id: 'star-21', position: 'edge-right-1', delay: '1.6s' },
  { id: 'star-22', position: 'edge-left-2', delay: '1s' },
  { id: 'star-23', position: 'edge-right-2', delay: '0.2s' },
  { id: 'star-24', position: 'edge-left-3', delay: '1.9s' },
  { id: 'star-25', position: 'edge-right-3', delay: '0.7s' },
  { id: 'star-26', position: 'edge-left-4', delay: '1.3s' },
  { id: 'star-27', position: 'edge-right-4', delay: '2.1s' },
];
---

<BaseLayout
  title="New Earth Network"
  description="A real-world community of conscious, awakened people gathering in person, in your city."
>
  <Hero />
  <Offerings />
  <Manifesto />
  <UpcomingGatherings />
  <FindYourCity />
  <WhatHappens />
  <StartGathering />
  <CommunityProof />
  <EmailSignup />

  <div class="stars" aria-hidden="true">
    {stars.map((star) => (
      <svg id={star.id} class={`star ${star.position}`} style={`animation-delay: ${star.delay}`} viewBox="0 0 20 20">
        <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
      </svg>
    ))}
    <div class="shooting-star shooting-star-1"></div>
    <div class="shooting-star shooting-star-2"></div>
    <div class="shooting-star shooting-star-3"></div>
    <div class="shooting-star shooting-star-4"></div>
  </div>
</BaseLayout>

<style>
  /* The page background lives in global.css, not here — every route gets the same
     atmosphere. The *background* punch-holes that used to sit at this spot are gone:
     full-bleed "deep" bands now use --gradient-veil, so they reveal the nebula by
     construction and no longer need a :has() specificity trick to override their own
     scoped background rule.

     The :has(.stars) selector itself is still in use below, for the unrelated job of
     lifting page content above the fixed star layer. That one is a legitimate anchor,
     not a workaround, and it stays. */

  .stars {
    --inner-orbit: min(15vw, 20vh);
    --outer-orbit: calc(var(--inner-orbit) * 2);
    /* Where Container.astro's content actually starts: half the leftover space
       once the page is wider than --container-max, plus the container's own
       padding — the exact box model .hero-content sits inside. halo-west/east
       are pinned to this rather than a raw viewport percentage (see below). */
    --content-inset: calc(max(0px, (100vw - var(--container-max)) / 2) + var(--container-padding));
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  :global(body:has(.stars) main > :not(.stars)),
  :global(body:has(.stars) .footer) {
    position: relative;
    z-index: 1;
  }

  .star {
    position: absolute;
    fill: var(--color-star-light);
    opacity: 0.28;
    translate: -50% -50%;
    /* Every star's size comes from --star-size, which each depth ring sets once to
       its rung on the celestial ladder (tokens.css). Width and glow both read it, so
       a star's halo is always a fixed fraction of the star — one rule, no per-tier
       filter arithmetic, and the phone step-down in tokens.css carries the glow with
       it automatically. */
    width: var(--star-size);
    /* Blue/cyan glow, not white-on-white — a white point radiating a plain white
       halo barely reads against itself and loses the tie to the logo's own
       electric blue/cyan aura, which is the whole point of these being "the
       same signal" rather than generic decorative sparkles. One drop-shadow, not
       three — this runs on 27 permanently-animating elements, so its cost is
       constant and multiplies fast. The fuller 3-layer bloom is reserved for the
       halo "hero" stars below, the only ones meant to read as genuinely bright. */
    filter: drop-shadow(0 0 calc(var(--star-size) * 0.25) var(--color-star-glow-soft));
  }

  .center { top: 50%; left: 50%; }
  .inner-east { top: 50%; left: calc(50% + var(--inner-orbit)); }
  .inner-northeast { top: calc(50% - (var(--inner-orbit) * .866)); left: calc(50% + (var(--inner-orbit) * .5)); }
  .inner-northwest { top: calc(50% - (var(--inner-orbit) * .866)); left: calc(50% - (var(--inner-orbit) * .5)); }
  .inner-west { top: 50%; left: calc(50% - var(--inner-orbit)); }
  .inner-southwest { top: calc(50% + (var(--inner-orbit) * .866)); left: calc(50% - (var(--inner-orbit) * .5)); }
  .inner-southeast { top: calc(50% + (var(--inner-orbit) * .866)); left: calc(50% + (var(--inner-orbit) * .5)); }
  .outer-east { top: 50%; left: calc(50% + var(--outer-orbit)); }
  .outer-northeast { top: max(calc(50% - (var(--outer-orbit) * .866)), calc(var(--nav-height) + var(--space-8))); left: calc(50% + (var(--outer-orbit) * .5)); }
  .outer-northwest { top: max(calc(50% - (var(--outer-orbit) * .866)), calc(var(--nav-height) + var(--space-8))); left: calc(50% - (var(--outer-orbit) * .5)); }
  .outer-west { top: 50%; left: calc(50% - var(--outer-orbit)); }
  .outer-southwest { top: calc(50% + (var(--outer-orbit) * .866)); left: calc(50% - (var(--outer-orbit) * .5)); }
  .outer-southeast { top: calc(50% + (var(--outer-orbit) * .866)); left: calc(50% + (var(--outer-orbit) * .5)); }
  /* halo-east/west sit at the same height as the hero copy (top: 50% lands right
     in the headline's band), so unlike every other star here they can't just be a
     viewport percentage — a flat 6%/94% was tuned against the old 1200px
     --container-max, and widening it (see tokens.css) pulled the hero content's
     left edge in far enough that this star ended up sitting behind "Stop asking."
     Pinning to --content-inset instead keeps a fixed 32px clearance from wherever
     the content edge actually is, so this stays correct if the container width
     (or the viewport) changes again instead of silently drifting back into text. */
  .halo-east { top: 50%; right: calc(var(--content-inset) - 32px); }
  .halo-northeast { top: max(14%, calc(var(--nav-height) + var(--space-8))); left: 72%; }
  .halo-northwest { top: max(14%, calc(var(--nav-height) + var(--space-8))); left: 28%; }
  .halo-west { top: 50%; left: calc(var(--content-inset) - 32px); }
  .halo-southwest { top: 86%; left: 28%; }
  .halo-southeast { top: 86%; left: 72%; }

  /* Edge fill, mirrored left/right around the 50% centerline. */
  .edge-left-1 { top: max(16%, calc(var(--nav-height) + var(--space-8))); left: 6%; }
  .edge-right-1 { top: max(16%, calc(var(--nav-height) + var(--space-8))); left: 94%; }
  .edge-left-2 { top: 36%; left: 9%; }
  .edge-right-2 { top: 36%; left: 91%; }
  .edge-left-3 { top: 64%; left: 9%; }
  .edge-right-3 { top: 64%; left: 91%; }
  .edge-left-4 { top: 84%; left: 6%; }
  .edge-right-4 { top: 84%; left: 94%; }

  /* Size is distance. The centre of the screen is the vanishing point and the frame
     edge is the foreground, so each ring out gets the next rung up the ladder. The
     edge fill sits at the same depth as the outer ring and now shares its rung — it
     used to have two clamp() widths of its own, which put edge stars in front of the
     outer ring on wide screens and behind it on narrow ones for no reason. */
  .center { --star-size: var(--star-size-far); }
  .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { --star-size: var(--star-size-mid); }
  .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast,
  .edge-left-1, .edge-right-1, .edge-left-2, .edge-right-2,
  .edge-left-3, .edge-right-3, .edge-left-4, .edge-right-4 { --star-size: var(--star-size-near); }
  .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast { --star-size: var(--star-size-fore); }

  .center { opacity: 0.16; }
  .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { opacity: 0.2; }
  .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast { opacity: 0.18; }
  .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast { opacity: 0.25; }
  .edge-left-1, .edge-right-1, .edge-left-4, .edge-right-4 { opacity: 0.22; }
  .edge-left-2, .edge-right-2, .edge-left-3, .edge-right-3 { opacity: 0.16; }
  /* The hero tier's 3-layer bloom: core, mid, wide at 0.2 / 0.6 / 1.2 of the star's
     own size — 8 / 24 / 48px against the 40px foreground rung. Same ratios as the
     one-layer ambient glow above, just carried out further, so a halo star reads as
     the same object radiating harder rather than a differently-lit one. */
  .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast {
    opacity: 0.65;
    filter:
      drop-shadow(0 0 calc(var(--star-size) * 0.2) var(--color-star-glow))
      drop-shadow(0 0 calc(var(--star-size) * 0.6) var(--color-star-glow-soft))
      drop-shadow(0 0 calc(var(--star-size) * 1.2) var(--color-star-glow-wide));
  }
  /*
    Shooting stars — same idea as the reference button (a thin streak falling on a
    diagonal), rebuilt for the full-page sky: positions in viewport percent instead of
    button-scoped px, the same white/cyan glow as the rest of .stars instead of a flat
    white gradient, and each cycle is mostly an invisible hold so any one streak is rare,
    not a steady drizzle.

    First pass: close-but-distinct periods (10/11/12/13s), picked by simulating the
    combined timeline. That got the worst pause down from ~10.7s to ~8s but couldn't go
    much further — distinct periods always drift back into phase eventually, and
    fighting that drift with closer and closer periods has diminishing returns.

    Second pass, to get the worst pause under 4s: all four periods are the SAME (19s)
    with delays spaced an exact quarter-period apart (0 / 4.75 / 9.5 / 14.25). Equal
    periods can't drift relative to each other, so the combined pattern is an exact,
    permanent repeat every 19s instead of a slowly-shifting one — the trade being made
    for a genuine ceiling on the pause instead of a statistically-unlikely-but-not-
    impossible long one. Measured worst gap 3.75s, simulated 1200s out. 19s (not
    something shorter) is what keeps each individual star still reappearing only every
    19s — as rare on its own as before — while the even quarter-period stagger is what
    keeps the four from ever bunching up the way the old spread-period version did.

    A same-period design would normally also make each streak's own on-screen crossing
    time balloon (that duration comes from the same number the keyframe percentages
    below are fractions of) — so the four @keyframes percentages were recalculated from
    each star's ORIGINAL absolute crossing time (e.g. shoot-1 took 2%-11% of its old 12s
    = 1.08s to cross and fade; at 19s that's now 5.7%-6.9%, not 2%-11%) rather than
    reused as-is. The four streaks still move at their original per-star speeds; only
    the hold between them changed.
  */
  /*
    Each star's line is tilted with rotate(), then travels by translateX() in that
    SAME rotated coordinate space — so "how far along its own length it slides" and
    "which way it's pointing" are the same number by construction. That guarantees the
    streak always moves exactly along its own axis (a real comet-trail look) on any
    screen, unlike animating top/left percentages, which scale against different axes
    (width vs. height) and made the line's fixed tilt drift out of sync with its actual
    direction of travel. The base position (top/left, unanimated) just picks where off
    the edge it starts; the fixed-px translate distance is generous enough to clear
    the far edge on any realistic monitor, so it always exits rather than fading out
    partway across.
  */
  .shooting-star {
    position: absolute;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--color-star-shooting), transparent);
    filter: drop-shadow(0 0 6px var(--color-star-shooting-glow));
    opacity: 0;
  }

  /* Length and thickness are set by depth, and depth is already encoded in each
     streak's angle: a shallow path across the frame is something passing nearby, a
     steep one is something falling away in the distance. So the two shallow streaks
     (-18deg, -25deg) take the near rung and the two steep ones (-48deg, -52deg) take
     the far rung, and thickness follows from length by the fixed 1:58 aspect. */
  .shooting-star-1, .shooting-star-3 {
    width: var(--star-streak-near);
    height: var(--star-streak-weight-near);
  }

  .shooting-star-2, .shooting-star-4 {
    width: var(--star-streak-far);
    height: var(--star-streak-weight-far);
  }

  .shooting-star-1 { top: -4%; left: 78%; animation: shoot-1 19s 0s ease-in infinite; }
  .shooting-star-2 { top: 8%; left: 54%; animation: shoot-2 19s 4.75s ease-in infinite; }
  .shooting-star-3 { top: -6%; left: 34%; animation: shoot-3 19s 9.5s ease-in infinite; }
  .shooting-star-4 { top: 14%; left: 94%; animation: shoot-4 19s 14.25s ease-in infinite; }

  @keyframes shoot-1 {
    0%, 100% { opacity: 0; transform: rotate(-25deg) translateX(0); }
    1.3% { opacity: 1; }
    5.7% { opacity: 1; transform: rotate(-25deg) translateX(-4200px); }
    6.9% { opacity: 0; }
  }

  @keyframes shoot-2 {
    0%, 100% { opacity: 0; transform: rotate(-52deg) translateX(0); }
    1.7% { opacity: 1; }
    6.7% { opacity: 1; transform: rotate(-52deg) translateX(-3200px); }
    8.4% { opacity: 0; }
  }

  @keyframes shoot-3 {
    0%, 100% { opacity: 0; transform: rotate(-18deg) translateX(0); }
    1.9% { opacity: 1; }
    9.5% { opacity: 1; transform: rotate(-18deg) translateX(-2600px); }
    11.4% { opacity: 0; }
  }

  @keyframes shoot-4 {
    0%, 100% { opacity: 0; transform: rotate(-48deg) translateX(0); }
    1.5% { opacity: 1; }
    6.6% { opacity: 1; transform: rotate(-48deg) translateX(-3200px); }
    8.1% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-star { display: none; }
  }

  @media (max-width: 640px) {
    .stars { --inner-orbit: min(13vw, 15vh); }
    .star { opacity: 0.18; }
    .center { opacity: 0.1; }
    .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { opacity: 0.18; }
    /* No width override here any more: tokens.css steps the whole ladder down one
       rung at this same breakpoint, so every tier shrinks together and the sky stays
       the same composition seen from further away. Only opacity is a mobile decision. */
    .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast { opacity: 0.2; }
    /* Halo stars are the only ones meant to read as genuinely bright (see their
       rule above) — hiding them on mobile removes the one thing actually making
       the sky look populated, leaving only the dimmed inner/outer rings, which
       reads as "the stars are gone." Keep them, just pull the ones nearest the
       hero copy in from the very edge so they don't crowd the headline.
       Opacity/filter are re-asserted here too: the generic ".star { opacity:
       0.18 }" rule above has equal selector specificity and comes later in the
       file than the desktop ".halo-east, .halo-west" brightness rule, so
       without this, that generic rule would silently win on mobile and dim
       these back down anyway. */
    .halo-west { left: 10%; }
    /* right, not left: the desktop rule above now sets halo-east's `right`
       (see --content-inset), and leaving a `left` here too would set both
       properties at once on the same absolutely-positioned, non-auto-width
       element — over-constrained, so `right` would be silently dropped as
       redundant instead of taking over at this breakpoint as intended. */
    .halo-east { right: 10%; }
    .halo-east, .halo-west {
      opacity: 0.65;
      filter:
        drop-shadow(0 0 calc(var(--star-size) * 0.2) var(--color-star-glow))
        drop-shadow(0 0 calc(var(--star-size) * 0.6) var(--color-star-glow-soft))
        drop-shadow(0 0 calc(var(--star-size) * 1.2) var(--color-star-glow-wide));
    }
    .edge-left-1, .edge-right-1, .edge-left-2, .edge-right-2,
    .edge-left-3, .edge-right-3, .edge-left-4, .edge-right-4 { display: none; }
  }
</style>
