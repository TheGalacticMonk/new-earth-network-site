---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Manifesto from '../components/home/Manifesto.astro';
import UpcomingGatherings from '../components/home/UpcomingGatherings.astro';
import FindYourCity from '../components/home/FindYourCity.astro';
import WhatHappens from '../components/home/WhatHappens.astro';
import StartGathering from '../components/home/StartGathering.astro';
import CommunityProof from '../components/home/CommunityProof.astro';
import EmailSignup from '../components/home/EmailSignup.astro';

const stars = [
  { id: 'star-1', position: 'center', delay: '0.3s' },
  { id: 'star-2', position: 'inner-east', delay: '0s' },
  { id: 'star-3', position: 'inner-northeast', delay: '0.6s' },
  { id: 'star-4', position: 'inner-northwest', delay: '1.3s' },
  { id: 'star-5', position: 'inner-west', delay: '0.9s' },
  { id: 'star-6', position: 'inner-southwest', delay: '1.6s' },
  { id: 'star-7', position: 'inner-southeast', delay: '1.1s' },
  { id: 'star-8', position: 'outer-east', delay: '0.4s' },
  { id: 'star-9', position: 'outer-northeast', delay: '1.8s' },
  { id: 'star-10', position: 'outer-northwest', delay: '0.7s' },
  { id: 'star-11', position: 'outer-west', delay: '1.4s' },
  { id: 'star-12', position: 'outer-southwest', delay: '0.2s' },
  { id: 'star-13', position: 'outer-southeast', delay: '1.2s' },
  { id: 'star-14', position: 'halo-east', delay: '0.5s' },
  { id: 'star-15', position: 'halo-northeast', delay: '1.7s' },
  { id: 'star-16', position: 'halo-northwest', delay: '0.8s' },
  { id: 'star-17', position: 'halo-west', delay: '2.2s' },
  { id: 'star-18', position: 'halo-southwest', delay: '1s' },
  { id: 'star-19', position: 'halo-southeast', delay: '1.5s' },
  // Edge fill — the orbit rings above are capped by viewport height, so on wide
  // desktop screens the far left/right margins stay empty. These sit at fixed
  // positions near the true edges instead, mirrored left/right for symmetry.
  { id: 'star-20', position: 'edge-left-1', delay: '0.4s' },
  { id: 'star-21', position: 'edge-right-1', delay: '1.6s' },
  { id: 'star-22', position: 'edge-left-2', delay: '1s' },
  { id: 'star-23', position: 'edge-right-2', delay: '0.2s' },
  { id: 'star-24', position: 'edge-left-3', delay: '1.9s' },
  { id: 'star-25', position: 'edge-right-3', delay: '0.7s' },
  { id: 'star-26', position: 'edge-left-4', delay: '1.3s' },
  { id: 'star-27', position: 'edge-right-4', delay: '2.1s' },
];
---

<BaseLayout
  title="New Earth Network"
  description="A real-world community of conscious, awakened people gathering in person, in your city."
>
  <Hero />
  <Manifesto />
  <UpcomingGatherings />
  <FindYourCity />
  <WhatHappens />
  <StartGathering />
  <CommunityProof />
  <EmailSignup />

  <div class="stars" aria-hidden="true">
    {stars.map((star) => (
      <svg id={star.id} class={`star ${star.position}`} style={`animation-delay: ${star.delay}`} viewBox="0 0 20 20">
        <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
      </svg>
    ))}
    <div class="shooting-star shooting-star-1"></div>
    <div class="shooting-star shooting-star-2"></div>
    <div class="shooting-star shooting-star-3"></div>
    <div class="shooting-star shooting-star-4"></div>
  </div>

  <div class="p" aria-hidden="true">
    <i><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u></i>
    <i><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u></i>
    <i><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u></i>
    <i><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u><u><b><b><b><b></b></b></b></b></u></i>
  </div>
  <div class="l" aria-hidden="true"></div>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 20% 25%, var(--color-nebula-violet), transparent 32%),
      radial-gradient(circle at 82% 30%, var(--color-nebula-orchid), transparent 30%),
      radial-gradient(circle at 28% 82%, var(--color-nebula-rose), transparent 32%),
      radial-gradient(circle at 80% 78%, var(--color-nebula-gold), transparent 35%),
      var(--color-bg-deep);
    background-attachment: fixed;
    color: var(--color-text-body);
  }

  :global(body:has(.p) .nav) {
    background: var(--color-nav-glass);
  }

  :global(body:has(.p) .cities),
  :global(body:has(.p) .signup),
  :global(body:has(.p) .cta[data-tone='deep']),
  :global(body:has(.p) .footer) {
    background: transparent;
  }

  .stars {
    --inner-orbit: min(15vw, 20vh);
    --outer-orbit: calc(var(--inner-orbit) * 2);
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  :global(body:has(.stars) main > :not(.stars):not(.p):not(.l)),
  :global(body:has(.stars) .footer) {
    position: relative;
    z-index: 1;
  }

  .star {
    position: absolute;
    fill: var(--color-star-light);
    opacity: 0.28;
    translate: -50% -50%;
    /* One drop-shadow, not three — this runs on 27 permanently-animating elements,
       so its cost is constant and multiplies fast. The fuller 3-layer bloom is
       reserved for the two halo "hero" stars below, which are the only ones meant
       to read as genuinely bright. */
    filter: drop-shadow(0 0 6px var(--color-star-glow-soft));
    animation-name: star-twinkle;
    animation-duration: 2s;
    animation-iteration-count: infinite;
  }

  .center { top: 50%; left: 50%; }
  .inner-east { top: 50%; left: calc(50% + var(--inner-orbit)); }
  .inner-northeast { top: calc(50% - (var(--inner-orbit) * .866)); left: calc(50% + (var(--inner-orbit) * .5)); }
  .inner-northwest { top: calc(50% - (var(--inner-orbit) * .866)); left: calc(50% - (var(--inner-orbit) * .5)); }
  .inner-west { top: 50%; left: calc(50% - var(--inner-orbit)); }
  .inner-southwest { top: calc(50% + (var(--inner-orbit) * .866)); left: calc(50% - (var(--inner-orbit) * .5)); }
  .inner-southeast { top: calc(50% + (var(--inner-orbit) * .866)); left: calc(50% + (var(--inner-orbit) * .5)); }
  .outer-east { top: 50%; left: calc(50% + var(--outer-orbit)); }
  .outer-northeast { top: max(calc(50% - (var(--outer-orbit) * .866)), calc(var(--nav-height) + var(--space-8))); left: calc(50% + (var(--outer-orbit) * .5)); }
  .outer-northwest { top: max(calc(50% - (var(--outer-orbit) * .866)), calc(var(--nav-height) + var(--space-8))); left: calc(50% - (var(--outer-orbit) * .5)); }
  .outer-west { top: 50%; left: calc(50% - var(--outer-orbit)); }
  .outer-southwest { top: calc(50% + (var(--outer-orbit) * .866)); left: calc(50% - (var(--outer-orbit) * .5)); }
  .outer-southeast { top: calc(50% + (var(--outer-orbit) * .866)); left: calc(50% + (var(--outer-orbit) * .5)); }
  .halo-east { top: 50%; left: 94%; }
  .halo-northeast { top: max(14%, calc(var(--nav-height) + var(--space-8))); left: 72%; }
  .halo-northwest { top: max(14%, calc(var(--nav-height) + var(--space-8))); left: 28%; }
  .halo-west { top: 50%; left: 6%; }
  .halo-southwest { top: 86%; left: 28%; }
  .halo-southeast { top: 86%; left: 72%; }

  /* Edge fill, mirrored left/right around the 50% centerline. */
  .edge-left-1 { top: max(16%, calc(var(--nav-height) + var(--space-8))); left: 6%; }
  .edge-right-1 { top: max(16%, calc(var(--nav-height) + var(--space-8))); left: 94%; }
  .edge-left-2 { top: 36%; left: 9%; }
  .edge-right-2 { top: 36%; left: 91%; }
  .edge-left-3 { top: 64%; left: 9%; }
  .edge-right-3 { top: 64%; left: 91%; }
  .edge-left-4 { top: 84%; left: 6%; }
  .edge-right-4 { top: 84%; left: 94%; }

  .center { width: 8px; }
  .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { width: 12px; }
  .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast { width: clamp(22px, 2.25vw, 34px); }
  .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast { width: clamp(18px, 1.8vw, 28px); }
  .edge-left-1, .edge-right-1, .edge-left-4, .edge-right-4 { width: clamp(20px, 2vw, 30px); }
  .edge-left-2, .edge-right-2, .edge-left-3, .edge-right-3 { width: clamp(16px, 1.6vw, 24px); }

  .center { opacity: 0.16; }
  .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { opacity: 0.2; }
  .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast { opacity: 0.18; }
  .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast { opacity: 0.25; }
  .edge-left-1, .edge-right-1, .edge-left-4, .edge-right-4 { opacity: 0.22; }
  .edge-left-2, .edge-right-2, .edge-left-3, .edge-right-3 { opacity: 0.16; }
  .halo-east, .halo-west {
    opacity: 0.65;
    filter:
      drop-shadow(0 0 6px var(--color-star-glow))
      drop-shadow(0 0 18px var(--color-star-glow-soft))
      drop-shadow(0 0 34px var(--color-star-glow-wide));
  }

  @keyframes star-twinkle {
    0% { transform: scale(1); }
    40% { transform: scale(1.2); }
    80% { transform: scale(0.8); }
    100% { transform: scale(1); }
  }

  /*
    Shooting stars — same idea as the reference button (a thin streak falling on a
    diagonal), rebuilt for the full-page sky: positions in viewport percent instead of
    button-scoped px, the same white/cyan glow as the rest of .stars instead of a flat
    white gradient, and each cycle is mostly an invisible hold so one appears every 20+
    seconds rather than every couple of seconds — a rare event, not a steady drizzle.
  */
  /*
    Each star's line is tilted with rotate(), then travels by translateX() in that
    SAME rotated coordinate space — so "how far along its own length it slides" and
    "which way it's pointing" are the same number by construction. That guarantees the
    streak always moves exactly along its own axis (a real comet-trail look) on any
    screen, unlike animating top/left percentages, which scale against different axes
    (width vs. height) and made the line's fixed tilt drift out of sync with its actual
    direction of travel. The base position (top/left, unanimated) just picks where off
    the edge it starts; the fixed-px translate distance is generous enough to clear
    the far edge on any realistic monitor, so it always exits rather than fading out
    partway across.
  */
  .shooting-star {
    position: absolute;
    width: 110px;
    height: 1.5px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--color-star-light), transparent);
    filter: drop-shadow(0 0 6px var(--color-star-glow-soft));
    opacity: 0;
  }

  .shooting-star-1 { top: -4%; left: 78%; animation: shoot-1 22s 2s ease-in infinite; }
  .shooting-star-2 { top: 8%; left: 54%; width: 90px; animation: shoot-2 28s 11s ease-in infinite; }
  .shooting-star-3 { top: -6%; left: 34%; width: 130px; animation: shoot-3 34s 19s ease-in infinite; }
  .shooting-star-4 { top: 14%; left: 94%; width: 90px; animation: shoot-4 26s 6s ease-in infinite; }

  @keyframes shoot-1 {
    0%, 100% { opacity: 0; transform: rotate(-25deg) translateX(0); }
    2% { opacity: 1; }
    9% { opacity: 1; transform: rotate(-25deg) translateX(-4200px); }
    11% { opacity: 0; }
  }

  @keyframes shoot-2 {
    0%, 100% { opacity: 0; transform: rotate(-52deg) translateX(0); }
    2% { opacity: 1; }
    8% { opacity: 1; transform: rotate(-52deg) translateX(-3200px); }
    10% { opacity: 0; }
  }

  @keyframes shoot-3 {
    0%, 100% { opacity: 0; transform: rotate(-18deg) translateX(0); }
    2% { opacity: 1; }
    10% { opacity: 1; transform: rotate(-18deg) translateX(-2600px); }
    12% { opacity: 0; }
  }

  @keyframes shoot-4 {
    0%, 100% { opacity: 0; transform: rotate(-48deg) translateX(0); }
    2% { opacity: 1; }
    9% { opacity: 1; transform: rotate(-48deg) translateX(-3200px); }
    11% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-star { display: none; }
  }

  .p { --x: 1.4s; --y: 1.4s; --X: 0px; --Y: 0px; position: fixed; z-index: 10; left: 50%; top: 50%; anchor-name: --p; transition: left var(--x) linear, top var(--y) linear; will-change: left, top; }
  .p > i { position: absolute; width: 100vw; height: 100vh; overflow: hidden; }
  .p > i:nth-child(odd) { right: 0; }
  .p > i:nth-child(even) { left: 0; }
  .p > i:nth-child(-n + 2) { bottom: 0; }
  .p > i:nth-child(n + 3) { top: 0; }
  .p:has(> i:first-child:hover) { --a: -12000px; --b: -12000px; }
  .p:has(> i:nth-child(2):hover) { --a: calc(100vw + 12000px); --b: -12000px; }
  .p:has(> i:nth-child(3):hover) { --a: -12000px; --b: calc(100vh + 12000px); }
  .p:has(> i:last-child:hover) { --a: calc(100vw + 12000px); --b: calc(100vh + 12000px); }
  .p:has(> i:hover) { left: calc(var(--a) + var(--X)); top: calc(var(--b) + var(--Y)); }
  .p :is(u, b) { position: absolute; }
  .p u { width: 100%; height: var(--s); }
  .p b { height: 100%; width: var(--s); }
  .p > i:nth-child(-n + 2) u { bottom: 0; }
  .p > i:nth-child(n + 3) u { top: 0; }
  .p > i:nth-child(odd) b { right: 0; }
  .p > i:nth-child(even) b { left: 0; }
  .p u:first-child, .p b { --s: 1800px; }
  .p u:nth-child(2), .p b b { --s: 220px; }
  .p u:nth-child(3), .p b b b { --s: 24px; }
  .p u:last-child, .p b b b b { --s: 2px; }
  .p:has(b:hover) { --x: 1.4s; --X: 0px; }
  .p:has(b b:hover) { --x: 8s; --X: 1px; }
  .p:has(b b b:hover) { --x: 70s; --X: 2px; }
  .p:has(b b b b:hover) { --x: 700s; --X: 3px; }
  .p:has(u:first-child:hover) { --y: 1.4s; --Y: 0px; }
  .p:has(u:nth-child(2):hover) { --y: 8s; --Y: 1px; }
  .p:has(u:nth-child(3):hover) { --y: 70s; --Y: 2px; }
  .p:has(u:last-child:hover) { --y: 700s; --Y: 3px; }
  .p:has(u:last-child:hover):has(b b b b:hover) { --x: 99999s; --y: 99999s; }
  .l { position: fixed; position-anchor: --p; z-index: 11; left: anchor(center); top: anchor(center); pointer-events: none; transition: left .07s ease-out, top .07s ease-out; will-change: left, top; isolation: isolate; }
  .l::before { content: ''; position: absolute; width: 300px; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: radial-gradient(circle, var(--color-nebula-violet-soft) 0, var(--color-nebula-orchid-soft) 35%, var(--color-nebula-cyan-soft) 52%, transparent 72%); }
  /* backdrop-filter here is the single most expensive effect on the page: it
     resamples everything behind a circle that re-renders on every mouse move.
     Stacking blur+saturate+contrast+hue-rotate was four expensive passes recomputed
     continuously; blur alone keeps the frosted-lens look at a fraction of the cost. */
  .l::after { content: ''; position: absolute; width: 150px; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); -webkit-mask: radial-gradient(circle, #000 38%, #000d 57%, #0007 73%, #0002 87%, #0000); mask: radial-gradient(circle, #000 38%, #000d 57%, #0007 73%, #0002 87%, #0000); }

  :global(body:has(.p) a),
  :global(body:has(.p) button),
  :global(body:has(.p) input),
  :global(body:has(.p) select),
  :global(body:has(.p) textarea) { position: relative; z-index: 12; }

  :global(body:has(.p) .card) {
    position: relative;
    z-index: 12;
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .p,
    .l { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .star { animation: none; }
  }

  @media (max-width: 640px) {
    .stars { --inner-orbit: min(13vw, 15vh); }
    .star { opacity: 0.18; }
    .center { opacity: 0.1; }
    .inner-east, .inner-northeast, .inner-northwest, .inner-west, .inner-southwest, .inner-southeast { opacity: 0.18; }
    .outer-east, .outer-northeast, .outer-northwest, .outer-west, .outer-southwest, .outer-southeast { width: 16px; opacity: 0.2; }
    .halo-east, .halo-northeast, .halo-northwest, .halo-west, .halo-southwest, .halo-southeast { display: none; }
    .edge-left-1, .edge-right-1, .edge-left-2, .edge-right-2,
    .edge-left-3, .edge-right-3, .edge-left-4, .edge-right-4 { display: none; }
  }
</style>
