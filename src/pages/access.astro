---
import '../styles/global.css';
import {
  ACCESS_COOKIE_NAME,
  accessCookieValue,
  passwordMatches,
  safeNextPath,
} from '../lib/access-auth.mjs';

let requestedNext = safeNextPath(Astro.url.searchParams.get('next'));
let hasError = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password');
  requestedNext = safeNextPath(formData.get('next'));

  if (typeof password === 'string' && passwordMatches(password)) {
    Astro.cookies.set(ACCESS_COOKIE_NAME, accessCookieValue(), {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
    });
    return Astro.redirect(requestedNext, 303);
  }

  hasError = true;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Private access — New Earth Network</title>
    <meta name="description" content="Private access to New Earth Network." />
  </head>
  <body>
    <main class="access" aria-labelledby="access-title">
      <section class="panel">
        <p class="signal" aria-hidden="true">Private signal</p>
        <h1 id="access-title">Enter the network</h1>
        <p class="intro">This transmission is currently private.</p>

        <form method="post" action="/access" class="form">
          <input type="hidden" name="next" value={requestedNext} />
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            aria-invalid={hasError ? 'true' : undefined}
            aria-describedby={hasError ? 'password-error' : undefined}
            autofocus={hasError}
          />
          {hasError && (
            <p id="password-error" class="error" role="alert">
              That password isn’t right. Try again.
            </p>
          )}
          <button type="submit">Enter</button>
        </form>
      </section>
    </main>
  </body>
</html>

<style>
  .access {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--container-padding);
  }

  .panel {
    width: min(100%, var(--hero-form-max));
    padding: clamp(var(--space-6), 6vw, var(--space-8));
    border-radius: var(--radius-xl);
    background: var(--color-overlay-surface);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(var(--space-4));
  }

  .signal {
    margin-block-end: var(--space-3);
    color: var(--color-electric-cyan);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-xl);
  }

  .intro {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }

  .form {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  label {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  input:not([type='hidden']) {
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: var(--cta-border-width) solid var(--color-placeholder-line);
    border-radius: var(--radius-md);
    background: var(--color-field-grey);
  }

  input:not([type='hidden']):focus-visible {
    border-color: var(--color-electric-cyan);
  }

  input[aria-invalid='true'] {
    border-color: var(--color-electric-pink);
  }

  button {
    min-height: var(--target-min);
    margin-block-start: var(--space-2);
    padding-inline: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-electric-cyan);
    color: var(--color-bg-deep);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  button:hover {
    background: var(--color-text-primary);
    box-shadow: var(--shadow-glow-sm);
  }

  .error {
    color: var(--color-electric-pink);
    font-size: var(--text-sm);
  }
</style>
