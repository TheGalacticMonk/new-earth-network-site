---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
---

<BaseLayout title="Principles" description="The values every New Earth Network gathering is built on.">
  <Section>
    <Container narrow>
      <h1>Community principles</h1>
      <p class="lead">
        Every New Earth Network gathering, in every city, holds to the same small set
        of principles. The full list is being finalized with our organizer community.
      </p>
      <p class="note">Coming soon.</p>
    </Container>
  </Section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
  }

  .lead {
    margin-top: var(--space-8);
    font-size: var(--text-md);
    color: var(--color-text-body);
  }

  .note {
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
