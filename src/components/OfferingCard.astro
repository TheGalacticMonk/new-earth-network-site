---
/*
  Implemented verbatim from the site owner's supplied template — geometry, colors,
  and animation timing untouched. Two changes only, both required to make one card
  design work as six repeated instances on a page rather than stylistic choices:

  1. `id="card"` / `id="prompt"` became `.card` / `.prompt`. HTML IDs must be unique
     per document; six copies of the same id is invalid markup and breaks anything
     that looks a card up by id later. Renaming to a class changes nothing visually —
     every rule that referenced #card / #prompt now references .card / .prompt.
  2. The tracker grid was completed from 9 divs to the full 25 (tr-1 through tr-25)
     the supplied CSS already defines grid-areas and :hover rules for — the supplied
     HTML stopped at tr-9, which would have left the bottom-right ~2/3 of each card's
     tilt surface dead. Generated with a loop rather than hand-typed to keep this
     file readable; the rendered markup is the same 25 divs either way.

  Theming (the neon green/blue palette, the always-on scan-line/cyber-line
  animations) is a deliberate follow-up pass, not done here.

  Content pass: the template's own placeholder copy ("HOVER ME", "CYBER CARD",
  "INTERACTIVE 3D EFFECT") is gone. The old .subtitle ("INTERACTIVE" /
  "3D EFFECT") described the template itself, not a card's content, so it's
  removed rather than repurposed.

  Title is no longer a hover reveal. It first held the same text as a
  separate always-visible .prompt element, faded in above it on hover — with
  real names in both, that read as the card's own name overlapping itself
  every time you hovered, not a flourish. .prompt is gone; .title is now the
  one always-visible name, moved up under the icon (font-size dropped
  28px -> 18px to fit there without wrapping badly) so the icon and the name
  are the first and only things read together at rest, per the site owner's
  call that visitors should see both immediately rather than one arriving on
  hover. An optional `description` prop reserves room for 2-3 sentences below
  the name — not filled in here, that copy is still pending — which is why
  the card grew (254px -> 320px tall): the fixed template height had no room
  left for it once the name stopped needing a hover to earn its place.
*/
interface Props {
  icon: string;
  label: string;
  labelBottom?: string;
  description?: string;
}

const { icon, label, labelBottom, description } = Astro.props;
const trackers = Array.from({ length: 25 }, (_, i) => i + 1);
---

<div class="offering-card noselect">
  <div class="canvas">
    {trackers.map((n) => (
      <div class={`tracker tr-${n}`}></div>
    ))}
    <div class="card">
      <div class="card-content">
        <div class="card-glare"></div>
        <div class="cyber-lines">
          <span></span><span></span><span></span><span></span>
        </div>
        {/* aria-hidden: decorative once .title says the same name in text —
            an image with alt text here would just make a screen reader
            announce "Events" twice. Color is the creative director's call
            (--color-text-primary, over cyan/pink — see tokens.css), applied
            the same mask + background-color way Hero.astro's wand icon is,
            so a per-card <img>'s own baked-in fill isn't a second source of
            truth for a color a one-line CSS change should be able to move. */}
        <span class="icon" aria-hidden="true" style={`--icon-src: url(${icon})`}></span>
        <div class="title">{label}{labelBottom && <><br />{labelBottom}</>}</div>
        {description && <p class="description">{description}</p>}
        <div class="glowing-elements">
          <div class="glow-1"></div>
          <div class="glow-2"></div>
          <div class="glow-3"></div>
        </div>
        <div class="card-particles">
          <span></span><span></span><span></span> <span></span><span></span><span></span>
        </div>
        <div class="corner-elements">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="scan-line"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Named .offering-card rather than the template's plain .container: this
     component sits inside the site's own Container.astro, which also renders
     class="container" — Astro's scoped styles keep the two from bleeding into
     each other, but two unrelated components answering to the same generic
     class name is a needless collision for anything (scripts, devtools,
     future components) that queries by class rather than through Astro's
     scoping. */
  /* 254px (the template's original height) fit a card whose only permanent
     content was an icon and a hover-only reveal. Once the name became
     always-visible and a 2-3 sentence description got its own reserved area
     below it (see .description), that height had nowhere to put either
     without cramming — grown to 320px to actually hold what the card now
     holds at rest, not just on hover. */
  .offering-card {
    position: relative;
    width: 190px;
    height: 320px;
    transition: 200ms;
  }

  .offering-card:active {
    width: 180px;
    height: 310px;
  }

  .card {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
    transition: 700ms;
    background: linear-gradient(45deg, #1a1a1a, #262626);
    border: 2px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    box-shadow:
      0 0 20px rgba(0, 0, 0, 0.3),
      inset 0 0 20px rgba(0, 0, 0, 0.2);
  }

  .card-content {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Plain top-center placement, always visible: this identifies the card at
     rest, it doesn't need a hover to earn it. 56px (more than double a
     standard 24px UI icon) made it the first thing the eye landed on, but
     left it competing with the card's own name for space; 40px is the
     middle ground — still clearly the dominant element, not so large it
     crowds the name below it. top: 28px clears the .corner-elements bracket
     (10px inset, 15px tall, bottom edge at 25px) the same as before.
     Color/mask technique: see the icon's markup comment above. */
  .icon {
    position: absolute;
    top: 28px;
    left: 50%;
    translate: -50% 0;
    z-index: 20;
    width: 40px;
    height: 40px;
    background: var(--color-text-primary);
    mask: var(--icon-src) center / contain no-repeat;
  }

  /* No longer a hover reveal (see file header) — always visible, moved up to
     sit right under the icon so both are the first and only things read
     together at rest. font-size dropped 28px -> 18px: 28px was sized for a
     one-word flourish that only had to look good for the moment it took to
     fade in; permanently under a 40px icon in a 190px-wide card, it wrapped
     "DOCS & FILMS" badly and pushed past the icon into its own space. */
  .title {
    position: absolute;
    top: 76px;
    left: 0;
    width: 100%;
    padding-inline: 12px;
    text-align: center;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.3;
    background: linear-gradient(45deg, #00ffaa, #00a2ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 15px rgba(0, 255, 170, 0.3));
    text-shadow:
      0 0 10px rgba(92, 103, 255, 0.5),
      0 0 20px rgba(92, 103, 255, 0.3);
  }

  /* Reserved space for the 2-3 sentence description that isn't written yet
     (see file header) — 130px clears even a two-line .title (76px + ~47px
     for two lines at this size + a small gap), and .offering-card's 320px
     height was sized with this block's room in mind, not just the icon and
     name above it. */
  .description {
    position: absolute;
    top: 130px;
    left: 0;
    width: 100%;
    padding-inline: 16px;
    text-align: center;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }

  .glowing-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glow-1,
  .glow-2,
  .glow-3 {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(0, 255, 170, 0.3) 0%,
      rgba(0, 255, 170, 0) 70%
    );
    filter: blur(15px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glow-1 {
    top: -20px;
    left: -20px;
  }
  .glow-2 {
    top: 50%;
    right: -30px;
    transform: translateY(-50%);
  }
  .glow-3 {
    bottom: -20px;
    left: 30%;
  }

  .card-particles span {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #00ffaa;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Hover effects */
  .tracker:hover ~ .card .glowing-elements div {
    opacity: 1;
  }

  .tracker:hover ~ .card .card-particles span {
    animation: particleFloat 2s infinite;
  }

  @keyframes particleFloat {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translate(calc(var(--x, 0) * 30px), calc(var(--y, 0) * 30px));
      opacity: 0;
    }
  }

  /* Particle positions */
  .card-particles span:nth-child(1) {
    --x: 1;
    --y: -1;
    top: 40%;
    left: 20%;
  }
  .card-particles span:nth-child(2) {
    --x: -1;
    --y: -1;
    top: 60%;
    right: 20%;
  }
  .card-particles span:nth-child(3) {
    --x: 0.5;
    --y: 1;
    top: 20%;
    left: 40%;
  }
  .card-particles span:nth-child(4) {
    --x: -0.5;
    --y: 1;
    top: 80%;
    right: 40%;
  }
  .card-particles span:nth-child(5) {
    --x: 1;
    --y: 0.5;
    top: 30%;
    left: 60%;
  }
  .card-particles span:nth-child(6) {
    --x: -1;
    --y: 0.5;
    top: 70%;
    right: 60%;
  }

  .card::before {
    content: '';
    background: radial-gradient(
      circle at center,
      rgba(0, 255, 170, 0.1) 0%,
      rgba(0, 162, 255, 0.05) 50%,
      transparent 100%
    );
    filter: blur(20px);
    opacity: 0;
    width: 150%;
    height: 150%;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
  }

  .tracker:hover ~ .card::before {
    opacity: 1;
  }

  .tracker {
    position: absolute;
    z-index: 200;
    width: 100%;
    height: 100%;
  }

  .tracker:hover {
    cursor: pointer;
  }

  .tracker:hover ~ .card {
    transition: 300ms;
    filter: brightness(1.1);
  }

  .offering-card:hover .card::before {
    transition: 200ms;
    content: '';
    opacity: 80%;
  }

  .canvas {
    perspective: 800px;
    inset: 0;
    z-index: 200;
    position: absolute;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr 1fr 1fr 1fr;
    gap: 0px 0px;
    grid-template-areas:
      'tr-1 tr-2 tr-3 tr-4 tr-5'
      'tr-6 tr-7 tr-8 tr-9 tr-10'
      'tr-11 tr-12 tr-13 tr-14 tr-15'
      'tr-16 tr-17 tr-18 tr-19 tr-20'
      'tr-21 tr-22 tr-23 tr-24 tr-25';
  }

  .tr-1 {
    grid-area: tr-1;
  }

  .tr-2 {
    grid-area: tr-2;
  }

  .tr-3 {
    grid-area: tr-3;
  }

  .tr-4 {
    grid-area: tr-4;
  }

  .tr-5 {
    grid-area: tr-5;
  }

  .tr-6 {
    grid-area: tr-6;
  }

  .tr-7 {
    grid-area: tr-7;
  }

  .tr-8 {
    grid-area: tr-8;
  }

  .tr-9 {
    grid-area: tr-9;
  }

  .tr-10 {
    grid-area: tr-10;
  }

  .tr-11 {
    grid-area: tr-11;
  }

  .tr-12 {
    grid-area: tr-12;
  }

  .tr-13 {
    grid-area: tr-13;
  }

  .tr-14 {
    grid-area: tr-14;
  }

  .tr-15 {
    grid-area: tr-15;
  }

  .tr-16 {
    grid-area: tr-16;
  }

  .tr-17 {
    grid-area: tr-17;
  }

  .tr-18 {
    grid-area: tr-18;
  }

  .tr-19 {
    grid-area: tr-19;
  }

  .tr-20 {
    grid-area: tr-20;
  }

  .tr-21 {
    grid-area: tr-21;
  }

  .tr-22 {
    grid-area: tr-22;
  }

  .tr-23 {
    grid-area: tr-23;
  }

  .tr-24 {
    grid-area: tr-24;
  }

  .tr-25 {
    grid-area: tr-25;
  }

  .tr-1:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(20deg) rotateY(-10deg) rotateZ(0deg);
  }

  .tr-2:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(20deg) rotateY(-5deg) rotateZ(0deg);
  }

  .tr-3:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(20deg) rotateY(0deg) rotateZ(0deg);
  }

  .tr-4:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(20deg) rotateY(5deg) rotateZ(0deg);
  }

  .tr-5:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(20deg) rotateY(10deg) rotateZ(0deg);
  }

  .tr-6:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(10deg) rotateY(-10deg) rotateZ(0deg);
  }

  .tr-7:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(10deg) rotateY(-5deg) rotateZ(0deg);
  }

  .tr-8:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(10deg) rotateY(0deg) rotateZ(0deg);
  }

  .tr-9:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(10deg) rotateY(5deg) rotateZ(0deg);
  }

  .tr-10:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(10deg) rotateY(10deg) rotateZ(0deg);
  }

  .tr-11:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(0deg) rotateY(-10deg) rotateZ(0deg);
  }

  .tr-12:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(0deg) rotateY(-5deg) rotateZ(0deg);
  }

  .tr-13:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg);
  }

  .tr-14:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(0deg) rotateY(5deg) rotateZ(0deg);
  }

  .tr-15:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(0deg) rotateY(10deg) rotateZ(0deg);
  }

  .tr-16:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-10deg) rotateY(-10deg) rotateZ(0deg);
  }

  .tr-17:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-10deg) rotateY(-5deg) rotateZ(0deg);
  }

  .tr-18:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-10deg) rotateY(0deg) rotateZ(0deg);
  }

  .tr-19:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-10deg) rotateY(5deg) rotateZ(0deg);
  }

  .tr-20:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-10deg) rotateY(10deg) rotateZ(0deg);
  }

  .tr-21:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-20deg) rotateY(-10deg) rotateZ(0deg);
  }

  .tr-22:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-20deg) rotateY(-5deg) rotateZ(0deg);
  }

  .tr-23:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-20deg) rotateY(0deg) rotateZ(0deg);
  }

  .tr-24:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-20deg) rotateY(5deg) rotateZ(0deg);
  }

  .tr-25:hover ~ .card {
    transition: 125ms ease-in-out;
    transform: rotateX(-20deg) rotateY(10deg) rotateZ(0deg);
  }

  .noselect {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  .card-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      125deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.05) 45%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 55%,
      rgba(255, 255, 255, 0) 100%
    );
    opacity: 0;
    transition: opacity 300ms;
  }

  .cyber-lines span {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(92, 103, 255, 0.2), transparent);
  }

  .cyber-lines span:nth-child(1) {
    top: 20%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: lineGrow 3s linear infinite;
  }

  .cyber-lines span:nth-child(2) {
    top: 40%;
    right: 0;
    width: 100%;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    animation: lineGrow 3s linear infinite 1s;
  }

  .cyber-lines span:nth-child(3) {
    top: 60%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: lineGrow 3s linear infinite 2s;
  }

  .cyber-lines span:nth-child(4) {
    top: 80%;
    right: 0;
    width: 100%;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    animation: lineGrow 3s linear infinite 1.5s;
  }

  .corner-elements span {
    position: absolute;
    width: 15px;
    height: 15px;
    border: 2px solid rgba(92, 103, 255, 0.3);
    transition: all 0.3s ease;
  }

  .corner-elements span:nth-child(1) {
    top: 10px;
    left: 10px;
    border-right: 0;
    border-bottom: 0;
  }

  .corner-elements span:nth-child(2) {
    top: 10px;
    right: 10px;
    border-left: 0;
    border-bottom: 0;
  }

  .corner-elements span:nth-child(3) {
    bottom: 10px;
    left: 10px;
    border-right: 0;
    border-top: 0;
  }

  .corner-elements span:nth-child(4) {
    bottom: 10px;
    right: 10px;
    border-left: 0;
    border-top: 0;
  }

  .scan-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, rgba(92, 103, 255, 0.1), transparent);
    transform: translateY(-100%);
    animation: scanMove 2s linear infinite;
  }

  @keyframes lineGrow {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes scanMove {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }

  .card:hover .card-glare {
    opacity: 1;
  }

  .card:hover .corner-elements span {
    border-color: rgba(92, 103, 255, 0.8);
    box-shadow: 0 0 10px rgba(92, 103, 255, 0.5);
  }
</style>
