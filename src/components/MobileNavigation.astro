---
import HeartSignalButton from './HeartSignalButton.astro';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
  primaryLabel: string;
  primaryHref: string;
}

const { links, primaryLabel, primaryHref } = Astro.props;
---

<div class="mobile-nav" id="mobile-nav" role="dialog" aria-modal="true" aria-label="Mobile navigation" hidden>
  <nav aria-label="Mobile">
    <ul role="list">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-cta">
      <HeartSignalButton href={primaryHref}>{primaryLabel}</HeartSignalButton>
    </div>
  </nav>
</div>

<style>
  .mobile-nav {
    position: fixed;
    inset: 0;
    top: var(--nav-height);
    z-index: var(--z-overlay);
    background: var(--color-bg-deep);
    animation: fade-in var(--duration-base) var(--ease-out);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  nav {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-8) var(--container-padding);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  li a {
    display: block;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
  }

  /* Just a positioning wrapper now — HeartSignalButton owns its own look. */
  .mobile-cta {
    margin-top: auto;
  }
</style>
