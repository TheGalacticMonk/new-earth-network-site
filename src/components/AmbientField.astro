---
// A restrained nighttime backdrop: a soft directional glow plus a static starfield,
// both computed at build time. No canvas, no JS, no images — just CSS box-shadows on
// two 1px points, generated from a fixed seed so the sky is identical on every render.
interface Props {
  variant?: 'hero' | 'section';
}

const { variant = 'section' } = Astro.props;

function seededRandom(seed: number) {
  let value = seed;
  return () => {
    value = (value * 9301 + 49297) % 233280;
    return value / 233280;
  };
}

function starField(seed: number, count: number, opacityRange: [number, number]) {
  const rand = seededRandom(seed);
  const shadows: string[] = [];
  for (let i = 0; i < count; i += 1) {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);
    const o = (opacityRange[0] + rand() * (opacityRange[1] - opacityRange[0])).toFixed(2);
    shadows.push(`${x}vw ${y}vh 0 0 rgba(255, 255, 255, ${o})`);
  }
  return shadows.join(', ');
}

const distantStars = starField(7, 90, [0.15, 0.45]);
const nearStars = starField(21, 24, [0.4, 0.75]);
---

<div class="ambient" data-variant={variant} aria-hidden="true">
  <div class="glow"></div>
  <div class="stars stars-distant" style={`box-shadow: ${distantStars};`}></div>
  <div class="stars stars-near" style={`box-shadow: ${nearStars};`}></div>
</div>

<style>
  .ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 50% 0%, var(--color-nebula-violet), transparent 70%);
  }

  .ambient[data-variant='section'] .glow {
    background: radial-gradient(45% 40% at 85% 10%, var(--color-nebula-cyan-soft), transparent 70%);
  }

  .stars {
    position: absolute;
    inset: 0;
    width: 1px;
    height: 1px;
  }

  .stars-near {
    animation: twinkle 6s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars-near {
      animation: none;
    }
  }
</style>
