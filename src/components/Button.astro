---
// Renders an <a> when href is given, a real <button> otherwise. Never a div with a
// click handler pretending to be either.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  size?: 'md' | 'lg';
}

const { href, variant = 'primary', type = 'button', size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class="btn"
  data-variant={variant}
  data-size={size}
  href={href}
  type={href ? undefined : type}
>
  <span class="btn-label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background var(--duration-base) var(--ease-out);
  }

  .btn[data-size='md'] {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-xs);
  }

  .btn[data-size='lg'] {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-sm);
  }

  .btn[data-variant='primary'] {
    background: var(--color-electric-cyan);
    color: var(--color-bg-deep);
  }

  .btn[data-variant='primary']:hover {
    box-shadow: var(--shadow-glow-md);
    transform: translateY(-1px);
  }

  .btn[data-variant='secondary'] {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .btn[data-variant='secondary']:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-glow-sm);
  }

  .btn[data-variant='ghost'] {
    background: transparent;
    color: var(--color-text-muted);
    padding-inline: var(--space-2);
  }

  .btn[data-variant='ghost']:hover {
    color: var(--color-text-primary);
  }

  .btn:active {
    transform: translateY(0);
  }
</style>
