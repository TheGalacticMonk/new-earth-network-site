---
import Container from './Container.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import MobileNavigation from './MobileNavigation.astro';

const links = [
  { label: 'About', href: '/about' },
  { label: 'Events', href: '/events' },
  { label: 'Cities', href: '/cities' },
  { label: 'Start a Gathering', href: '/start-a-gathering' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <Container>
    <div class="nav-row">
      <a href="/" class="brand" aria-label="New Earth Network — home">
        <Logo variant="full" priority />
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        <ul role="list">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav-actions">
        <div class="desktop-cta">
          <Button href="/events" variant="primary">Find a Gathering</Button>
        </div>
        <button
          id="nav-toggle"
          class="toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="visually-hidden">Menu</span>
          <svg class="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<!--
  Rendered outside <header> deliberately: the header's backdrop-filter creates a new
  containing block for position:fixed descendants, which would trap this panel inside
  the 64px header box instead of covering the viewport.
-->
<MobileNavigation links={links} primaryLabel="Find a Gathering" primaryHref="/events" />

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    panel?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    panel?.querySelector('a')?.focus();
  }

  function closeMenu({ restoreFocus = false } = {}) {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (restoreFocus) toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') closeMenu();
  });

  panel?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (event.key !== 'Tab') return;

    const focusable = panel.querySelectorAll<HTMLElement>('a, button');
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: rgba(46, 42, 63, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand :global(img) {
    height: 28px;
    width: auto;
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .desktop-nav a {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text-body);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--color-electric-cyan);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-cta {
    display: none;
  }

  .toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
  }

  .icon-close {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 900px) {
    .desktop-nav,
    .desktop-cta {
      display: flex;
    }

    .toggle {
      display: none;
    }
  }
</style>
