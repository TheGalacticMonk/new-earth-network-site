---
import Container from './Container.astro';
import Logo from './Logo.astro';
import HeartSignalButton from './HeartSignalButton.astro';
import MobileNavigation from './MobileNavigation.astro';

const links = [
  { label: 'Events', href: '/events' },
  { label: 'Docs', href: '/docs' },
  { label: 'Films', href: '/films' },
  { label: 'Courses', href: '/courses' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-stars" aria-hidden="true">
    <span class="nav-star star-1"></span>
    <span class="nav-star star-2"></span>
    <span class="nav-star star-3"></span>
    <span class="nav-star star-4"></span>
    <span class="nav-star star-5"></span>
    <span class="nav-star star-6"></span>
    <span class="nav-star star-7"></span>
    <span class="nav-star star-8"></span>
    <span class="nav-star star-9"></span>
    <span class="nav-star star-10"></span>
    <span class="nav-star star-11"></span>
    <span class="nav-star star-12"></span>
    <span class="nav-star star-13"></span>
    <span class="nav-star star-14"></span>
  </div>
  <Container>
    <div class="nav-row">
      <a href="/" class="brand" aria-label="New Earth Network — home">
        <Logo variant="full" priority width={500} />
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        <ul role="list">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav-actions">
        <div class="desktop-cta">
          <HeartSignalButton href="/#subscribe">Subscribe</HeartSignalButton>
        </div>
        <button
          id="nav-toggle"
          class="toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="visually-hidden">Menu</span>
          <svg class="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<!--
  Rendered outside <header> deliberately: the header clips its own children
  (overflow: hidden, for the nav starfield), which would trap this panel inside the
  header's own (short) box instead of covering the viewport. The backdrop-filter that
  used to be the reason for this has moved to .nav::before, but the clipping reason
  stands on its own, so the panel stays out here.
-->
<MobileNavigation links={links} primaryLabel="Subscribe" primaryHref="/#subscribe" />

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    panel?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    panel?.querySelector('a')?.focus();
  }

  function closeMenu({ restoreFocus = false } = {}) {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (restoreFocus) toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') closeMenu();
  });

  panel?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (event.key !== 'Tab') return;

    const focusable = panel.querySelectorAll<HTMLElement>('a, button');
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    overflow: hidden;
  }

  /*
    The glass lives on its own layer, not on .nav, so the tint can fade out without
    taking the masthead's content with it — fading .nav itself would fade the logo and
    the links too.

    The tint fades; the blur does not. See --gradient-nav-glass in tokens.css for why
    that split is load-bearing rather than incidental.

    The drop shadow that used to sit here is deliberately gone: a shadow cast by the
    nav's bottom edge is the strongest possible statement that the nav is a bar sitting
    on top of the page, which is precisely what the fade is undoing.

    `isolation: isolate` is gone from .nav for a load-bearing reason, not tidiness:
    isolation forms a backdrop root, so a backdrop-filter on a child of an isolated
    element has nothing behind it to sample and the blur silently does nothing. The
    stacking context .nav-stars relies on is still there — position:sticky plus a
    non-auto z-index creates one on its own.
  */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--gradient-nav-glass);
    backdrop-filter: blur(10px);
  }

  .nav-stars {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .nav-star {
    position: absolute;
    left: -10rem;
    top: var(--star-top);
    width: var(--star-length);
    height: var(--star-streak-weight-nav);
    pointer-events: none;
    opacity: var(--star-opacity);
    background: linear-gradient(90deg, transparent, var(--color-star-light));
    filter: drop-shadow(0 0 3px var(--color-star-glow-soft));
    transform: rotate(var(--star-angle));
    transform-origin: left center;
    will-change: transform;
    animation: nav-star-flight var(--star-duration) linear var(--star-delay) infinite;
  }

  /* Four rungs of --star-streak-nav-*, not fourteen bespoke lengths. Distribution is
     5/4/3/2 from shortest to longest: a depth field has more far objects than near
     ones, and it keeps the two longest streaks rare enough to stay events. Each star
     sits on the rung its old length ranked into, so length still tracks --star-opacity
     the way it did — longer reads nearer, and nearer reads brighter. */
  .star-1 { --star-top: 14%; --star-length: var(--star-streak-nav-3); --star-angle: -4deg; --star-opacity: 0.56; --star-duration: 6.8s; --star-delay: -1.2s; }
  .star-2 { --star-top: 31%; --star-length: var(--star-streak-nav-1); --star-angle: 3deg; --star-opacity: 0.34; --star-duration: 10.4s; --star-delay: -7.8s; }
  .star-3 { --star-top: 49%; --star-length: var(--star-streak-nav-4); --star-angle: -2deg; --star-opacity: 0.46; --star-duration: 8.1s; --star-delay: -4.1s; }
  .star-4 { --star-top: 71%; --star-length: var(--star-streak-nav-2); --star-angle: 5deg; --star-opacity: 0.28; --star-duration: 12.6s; --star-delay: -2.5s; }
  .star-5 { --star-top: 86%; --star-length: var(--star-streak-nav-3); --star-angle: -5deg; --star-opacity: 0.42; --star-duration: 7.4s; --star-delay: -5.6s; }
  .star-6 { --star-top: 23%; --star-length: var(--star-streak-nav-1); --star-angle: 2deg; --star-opacity: 0.24; --star-duration: 14.2s; --star-delay: -9.4s; }
  .star-7 { --star-top: 60%; --star-length: var(--star-streak-nav-2); --star-angle: -3deg; --star-opacity: 0.38; --star-duration: 9.3s; --star-delay: -6.2s; }
  .star-8 { --star-top: 40%; --star-length: var(--star-streak-nav-4); --star-angle: 4deg; --star-opacity: 0.48; --star-duration: 6.3s; --star-delay: -3.6s; }
  .star-9 { --star-top: 78%; --star-length: var(--star-streak-nav-1); --star-angle: -1deg; --star-opacity: 0.3; --star-duration: 11.7s; --star-delay: -8.7s; }
  .star-10 { --star-top: 7%; --star-length: var(--star-streak-nav-2); --star-angle: 3deg; --star-opacity: 0.36; --star-duration: 8.8s; --star-delay: -0.8s; }
  .star-11 { --star-top: 18%; --star-length: var(--star-streak-nav-1); --star-angle: 1deg; --star-opacity: 0.32; --star-duration: 13.1s; --star-delay: -10.2s; }
  .star-12 { --star-top: 36%; --star-length: var(--star-streak-nav-3); --star-angle: -6deg; --star-opacity: 0.44; --star-duration: 7.1s; --star-delay: -5.1s; }
  .star-13 { --star-top: 55%; --star-length: var(--star-streak-nav-1); --star-angle: 4deg; --star-opacity: 0.22; --star-duration: 15.4s; --star-delay: -12.6s; }
  .star-14 { --star-top: 67%; --star-length: var(--star-streak-nav-2); --star-angle: -2deg; --star-opacity: 0.4; --star-duration: 9.8s; --star-delay: -1.9s; }

  @keyframes nav-star-flight {
    from { transform: translateX(0) rotate(var(--star-angle)); }
    to { transform: translateX(120vw) rotate(var(--star-angle)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-star { animation: none; }
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .brand {
    position: relative;
    display: flex;
    align-items: center;
    margin-inline-start: calc(-1 * var(--nav-logo-optical-inset));
    flex-shrink: 0;
    --nav-icon-center-x: calc(var(--nav-logo-height) * 0.4975);
  }

  .brand :global(img) {
    height: var(--nav-logo-height);
    width: auto;
  }

  .brand::before,
  .brand::after {
    content: '';
    position: absolute;
    top: calc(var(--nav-logo-height) / 2);
    left: var(--nav-icon-center-x);
    width: calc(var(--nav-logo-height) * 1.09);
    height: calc(var(--nav-logo-height) * 1.09);
    translate: -50% -50%;
    border: calc(var(--nav-logo-height) * 0.13) solid var(--color-electric-rose);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    animation: nav-signal-pulse 3s ease-out infinite;
  }

  .brand::after {
    animation-delay: 1.5s;
  }

  @keyframes nav-signal-pulse {
    0% {
      border-width: calc(var(--nav-logo-height) * 0.13);
      transform: scale(0);
      opacity: 0.55;
    }
    100% {
      border-width: 0;
      transform: scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand::before,
    .brand::after {
      animation: none;
      opacity: 0;
    }
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .desktop-nav a {
    position: relative;
    z-index: 0;
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text-body);
    cursor: pointer;
    transition: color var(--duration-nav-activate) var(--ease-nav-activate);
  }

  /* Two hairlines that converge onto the link — scaled to double height and
     invisible at rest, sweeping in from outside the link's edges as the plum fill
     grows from the center to meet them. Plum reads fine as the settled fill, but
     is nearly invisible as a thin line against the nav's own dark glass — so the
     lines use the solid, full-opacity violet instead, to actually read during
     the sweep. */
  .desktop-nav a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: scaleY(2);
    border-style: solid;
    border-color: var(--color-electric-violet-soft);
    border-width: 2px 0 2px 0;
    opacity: 0;
    pointer-events: none;
    transition: all var(--duration-nav-activate) var(--ease-nav-activate);
  }

  /* A solid plum fill, swept in behind the link on hover/active. */
  .desktop-nav a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg-elevated);
    transform: scale(0);
    pointer-events: none;
    transition: all var(--duration-nav-activate) var(--ease-nav-activate);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--color-text-primary);
  }

  .desktop-nav a:hover::before,
  .desktop-nav a[aria-current='page']::before {
    transform: scaleY(0);
    opacity: 1;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleY(1);
  }

  .desktop-nav a:active {
    scale: 0.9;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-cta {
    display: none;
  }

  .toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
  }

  .icon-close {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 1180px) {
    .desktop-nav,
    .desktop-cta {
      display: flex;
    }

    .toggle {
      display: none;
    }
  }
</style>
