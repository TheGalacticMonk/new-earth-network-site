---
import Container from './Container.astro';
import Logo from './Logo.astro';
import HeartSignalButton from './HeartSignalButton.astro';
import MobileNavigation from './MobileNavigation.astro';

const links = [
  { label: 'Events', href: '/events' },
  { label: 'Series', href: '/series' },
  { label: 'Docs & Films', href: '/docs-films' },
  { label: 'Music', href: '/music' },
  { label: 'Courses', href: '/courses' },
  { label: 'Shop', href: '/shop' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-stars" aria-hidden="true">
    <span class="nav-star star-1"></span>
    <span class="nav-star star-2"></span>
    <span class="nav-star star-3"></span>
    <span class="nav-star star-4"></span>
    <span class="nav-star star-5"></span>
    <span class="nav-star star-6"></span>
    <span class="nav-star star-7"></span>
    <span class="nav-star star-8"></span>
    <span class="nav-star star-9"></span>
    <span class="nav-star star-10"></span>
    <span class="nav-star star-11"></span>
    <span class="nav-star star-12"></span>
    <span class="nav-star star-13"></span>
    <span class="nav-star star-14"></span>
  </div>
  <Container>
    <div class="nav-row">
      <a href="/" class="brand" aria-label="New Earth Network — home">
        {/* The third wavefront. .brand's ::before and ::after carry the first two;
            a third ring needs a real node, and an empty aria-hidden span inside a
            link that already carries its own aria-label is the smallest one that
            changes nothing about the logo's markup or its accessible name. */}
        <span class="brand-ring" aria-hidden="true"></span>
        <Logo variant="full" priority width={500} />
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        <ul role="list">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav-actions">
        <div class="desktop-cta">
          <HeartSignalButton href="/#subscribe">Subscribe</HeartSignalButton>
        </div>
        <button
          id="nav-toggle"
          class="toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="visually-hidden">Menu</span>
          <svg class="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<!--
  Rendered outside <header> deliberately: the header clips its own children
  (overflow: hidden, for the nav starfield), which would trap this panel inside the
  header's own (short) box instead of covering the viewport. The backdrop-filter that
  used to be the reason for this has moved to .nav::before, but the clipping reason
  stands on its own, so the panel stays out here.
-->
<MobileNavigation links={links} primaryLabel="Subscribe" primaryHref="/#subscribe" />

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    panel?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    panel?.querySelector('a')?.focus();
  }

  function closeMenu({ restoreFocus = false } = {}) {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (restoreFocus) toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') closeMenu();
  });

  panel?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (event.key !== 'Tab') return;

    const focusable = panel.querySelectorAll<HTMLElement>('a, button');
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  /* The panel's own open/closed state is tracked only by the `hidden` attribute
     above — nothing in its CSS hides it at desktop widths, because it isn't
     meant to exist at desktop widths at all; .toggle (the only thing that can
     close it) disappears there instead. Resize the window past that breakpoint
     while the panel is open — e.g. narrow, open the menu, then widen — and
     there is no longer any control left that can close it, while the desktop
     nav renders underneath it and the page stays scroll-locked. This breakpoint
     must match the `min-width` below, where .toggle is hidden. */
  const desktopQuery = window.matchMedia('(min-width: 1180px)');
  desktopQuery.addEventListener('change', (event) => {
    if (event.matches && toggle?.getAttribute('aria-expanded') === 'true') closeMenu();
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    overflow: hidden;
  }

  /*
    The glass lives on its own layer, not on .nav, so the tint can fade out without
    taking the masthead's content with it — fading .nav itself would fade the logo and
    the links too.

    The tint fades; the blur does not. See --gradient-nav-glass in tokens.css for why
    that split is load-bearing rather than incidental.

    The drop shadow that used to sit here is deliberately gone: a shadow cast by the
    nav's bottom edge is the strongest possible statement that the nav is a bar sitting
    on top of the page, which is precisely what the fade is undoing.

    `isolation: isolate` is gone from .nav for a load-bearing reason, not tidiness:
    isolation forms a backdrop root, so a backdrop-filter on a child of an isolated
    element has nothing behind it to sample and the blur silently does nothing. The
    stacking context .nav-stars relies on is still there — position:sticky plus a
    non-auto z-index creates one on its own.
  */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--gradient-nav-glass);
    backdrop-filter: blur(10px);
  }

  .nav-stars {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .nav-star {
    position: absolute;
    left: -10rem;
    top: var(--star-top);
    width: var(--star-length);
    height: var(--star-streak-weight-nav);
    pointer-events: none;
    opacity: var(--star-opacity);
    background: linear-gradient(90deg, transparent, var(--color-star-light));
    filter: drop-shadow(0 0 3px var(--color-star-glow-soft));
    transform: rotate(var(--star-angle));
    transform-origin: left center;
    will-change: transform;
    animation: nav-star-flight var(--star-duration) linear var(--star-delay) infinite;
  }

  /* Four rungs of --star-streak-nav-*, not fourteen bespoke lengths. Distribution is
     5/4/3/2 from shortest to longest: a depth field has more far objects than near
     ones, and it keeps the two longest streaks rare enough to stay events. Each star
     sits on the rung its old length ranked into, so length still tracks --star-opacity
     the way it did — longer reads nearer, and nearer reads brighter. */
  .star-1 { --star-top: 14%; --star-length: var(--star-streak-nav-3); --star-angle: -4deg; --star-opacity: 0.56; --star-duration: 6.8s; --star-delay: -1.2s; }
  .star-2 { --star-top: 31%; --star-length: var(--star-streak-nav-1); --star-angle: 3deg; --star-opacity: 0.34; --star-duration: 10.4s; --star-delay: -7.8s; }
  .star-3 { --star-top: 49%; --star-length: var(--star-streak-nav-4); --star-angle: -2deg; --star-opacity: 0.46; --star-duration: 8.1s; --star-delay: -4.1s; }
  .star-4 { --star-top: 71%; --star-length: var(--star-streak-nav-2); --star-angle: 5deg; --star-opacity: 0.28; --star-duration: 12.6s; --star-delay: -2.5s; }
  .star-5 { --star-top: 86%; --star-length: var(--star-streak-nav-3); --star-angle: -5deg; --star-opacity: 0.42; --star-duration: 7.4s; --star-delay: -5.6s; }
  .star-6 { --star-top: 23%; --star-length: var(--star-streak-nav-1); --star-angle: 2deg; --star-opacity: 0.24; --star-duration: 14.2s; --star-delay: -9.4s; }
  .star-7 { --star-top: 60%; --star-length: var(--star-streak-nav-2); --star-angle: -3deg; --star-opacity: 0.38; --star-duration: 9.3s; --star-delay: -6.2s; }
  .star-8 { --star-top: 40%; --star-length: var(--star-streak-nav-4); --star-angle: 4deg; --star-opacity: 0.48; --star-duration: 6.3s; --star-delay: -3.6s; }
  .star-9 { --star-top: 78%; --star-length: var(--star-streak-nav-1); --star-angle: -1deg; --star-opacity: 0.3; --star-duration: 11.7s; --star-delay: -8.7s; }
  .star-10 { --star-top: 7%; --star-length: var(--star-streak-nav-2); --star-angle: 3deg; --star-opacity: 0.36; --star-duration: 8.8s; --star-delay: -0.8s; }
  .star-11 { --star-top: 18%; --star-length: var(--star-streak-nav-1); --star-angle: 1deg; --star-opacity: 0.32; --star-duration: 13.1s; --star-delay: -10.2s; }
  .star-12 { --star-top: 36%; --star-length: var(--star-streak-nav-3); --star-angle: -6deg; --star-opacity: 0.44; --star-duration: 7.1s; --star-delay: -5.1s; }
  .star-13 { --star-top: 55%; --star-length: var(--star-streak-nav-1); --star-angle: 4deg; --star-opacity: 0.22; --star-duration: 15.4s; --star-delay: -12.6s; }
  .star-14 { --star-top: 67%; --star-length: var(--star-streak-nav-2); --star-angle: -2deg; --star-opacity: 0.4; --star-duration: 9.8s; --star-delay: -1.9s; }

  @keyframes nav-star-flight {
    from { transform: translateX(0) rotate(var(--star-angle)); }
    to { transform: translateX(120vw) rotate(var(--star-angle)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-star { animation: none; }
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .brand {
    position: relative;
    display: flex;
    align-items: center;
    margin-inline-start: calc(-1 * var(--nav-logo-optical-inset));
    flex-shrink: 0;
    --nav-icon-center-x: calc(var(--nav-logo-height) * 0.4975);
  }

  .brand :global(img) {
    height: var(--nav-logo-height);
    width: auto;
  }

  /*
    Three wavefronts leaving the logo mark — the transmitter metaphor made literal.
    Why three and not two: two rings can only ever alternate, and alternation reads
    as one ring repeating. Three is the smallest count where you see concentric
    circles at different radii *at the same time*, which is the entire idea. A fourth
    adds no new information and crowds the ~20px of travel the nav's clip allows.

    Geometry is measured off the mark, not guessed: the icon's circle stroke has an
    outer diameter of 0.777 x --nav-logo-height (its glow reaches 0.879). The rings
    are therefore born at 0.78 and only ever travel outward — the previous version
    started at scale(0) and spent most of its life expanding *behind* the artwork,
    where the mark's transparent interior let it show through. That, not the ring
    count, is what made it read as a blob rather than a signal.

    Each ring differs in reach, peak brightness and stroke weight, and all three are
    born at the same rim: one source, successive emissions, each carrying less energy
    than the last. Energy is the only dimension that varies, and the hue deliberately
    does not. A different colour per ring would read as different *sources*, which is
    the opposite of the idea — concentric wavefronts mean one transmitter emitting
    repeatedly. At 2–3px wide, three hues would also read as chromatic fringing rather
    than as three colours. So all three are --color-electric-pink, and the hot pink is
    the only warm thing near a mark that glows cyan: the contrast against the logo's
    own aura is what lets the emission read as leaving the mark rather than as part
    of it.

    The peaks are a ladder, not three independent numbers — 0.9 / 0.62 / 0.38 holds
    the same 1 : 0.69 : 0.42 decay the dimmer first pass had. When the site owner
    asked for more presence, the whole ladder was scaled rather than flattened,
    because the falloff between rings *is* the meaning: flatten it and three equal
    rings stop being one transmitter losing energy and become three unrelated circles.
    --ring-peak is the knob for overall intensity; keep the ratios if you turn it.
  */
  /* `content` is set only on the pseudos — on a real element it would make
     .brand-ring a replaced element with no intrinsic size. */
  .brand::before,
  .brand::after {
    content: '';
  }

  .brand::before,
  .brand::after,
  .brand-ring {
    position: absolute;
    top: calc(var(--nav-logo-height) / 2);
    left: var(--nav-icon-center-x);
    /* Birth diameter: just outside the mark's circle stroke (0.777) and still inside
       its glow (0.879), so each wavefront appears to detach from the mark rather
       than fade up in empty space. */
    width: calc(var(--nav-logo-height) * 0.78);
    height: calc(var(--nav-logo-height) * 0.78);
    translate: -50% -50%;
    border: var(--ring-weight) solid var(--color-electric-pink);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    /*
      linear, not --ease-out, and this is the one place on the site where that is the
      right answer: a wavefront travels at constant speed. --ease-out would fling all
      three rings to their outer radius in the first third of the cycle, where they
      would pile up on top of each other — the concentric spacing that carries the
      whole read only survives constant velocity.
    */
    animation: nav-signal-pulse var(--duration-nav-signal-cycle) linear var(--ring-delay) infinite;
  }

  /* --ring-reach is a multiple of the birth diameter, and the lead ring's 1.45 is a
     hard ceiling, not a taste call: the nav is 122px tall with `overflow: hidden`, so
     anything past a 61px radius gets sliced flat by the top and bottom edges. 1.45
     lands at 60px at the largest logo size. Measured, not assumed — 1.56 was tried and
     the arc is visibly guillotined at the masthead's top edge. */
  .brand::before {
    --ring-reach: 1.45;
    --ring-peak: 0.9;
    --ring-weight: calc(var(--nav-logo-height) * 0.024);
    --ring-delay: 0s;
  }

  .brand::after {
    --ring-reach: 1.3;
    --ring-peak: 0.62;
    --ring-weight: calc(var(--nav-logo-height) * 0.019);
    --ring-delay: var(--duration-nav-signal-stagger);
  }

  .brand-ring {
    --ring-reach: 1.16;
    --ring-peak: 0.38;
    --ring-weight: calc(var(--nav-logo-height) * 0.015);
    --ring-delay: calc(var(--duration-nav-signal-stagger) * 2);
  }

  /*
    Transform and opacity only — neither triggers layout or repaint, so all three
    rings run on the compositor. (The version this replaces animated border-width,
    which is a layout property; adding a third ring to that would have put 50% more
    per-frame main-thread work into a sticky nav that is on screen on every page.
    This version removes that cost rather than growing it.)

    Travel occupies the first 50% of the cycle; the rest is held at zero opacity and
    is this ring's share of the silence between transmissions.

    These stops look like odd numbers because they are absolute times expressed as
    percentages of a --cycle that has changed once. Against the current 4s they are
    0.35s ignition, 1.5s half-brightness, 2s death. When the burst gap was shortened
    from 2s to 1s, --cycle went 5s → 4s and every stop was rescaled by 5/4 so those
    three absolute times — and therefore the wavefront's velocity and the shape of its
    fade — came through the change untouched. Keep doing that: the percentages are
    derived from --cycle, not independent taste.

    The fade is shaped rather than linear: a fast ignition, then a long plateau that
    only collapses in the last quarter of the travel. A straight linear fade is the
    physically honest version, but it makes each wavefront dimmest exactly when it is
    furthest out and therefore most separated from the others — which erases the
    concentric structure at the one moment it is legible.
  */
  @keyframes nav-signal-pulse {
    0% {
      transform: scale(1);
      opacity: 0;
    }
    8.75% {
      opacity: var(--ring-peak);
    }
    37.5% {
      opacity: calc(var(--ring-peak) * 0.5);
    }
    50%,
    100% {
      transform: scale(var(--ring-reach));
      opacity: 0;
    }
  }

  /* The global blanket rule collapses animation-duration, which is not enough on its
     own for an infinite ambient loop — this stops it outright. No opacity reset is
     needed: the rings' resting opacity is already 0, so with no animation running
     nothing paints. */
  @media (prefers-reduced-motion: reduce) {
    .brand::before,
    .brand::after,
    .brand-ring {
      animation: none;
    }
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .desktop-nav a {
    position: relative;
    z-index: 0;
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text-body);
    cursor: pointer;
    transition: color var(--duration-nav-activate) var(--ease-nav-activate);
  }

  /* Two hairlines that converge onto the link — scaled to double height and
     invisible at rest, sweeping in from outside the link's edges as the plum fill
     grows from the center to meet them. Plum reads fine as the settled fill, but
     is nearly invisible as a thin line against the nav's own dark glass — so the
     lines use the solid, full-opacity violet instead, to actually read during
     the sweep. */
  .desktop-nav a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: scaleY(2);
    border-style: solid;
    border-color: var(--color-electric-violet-soft);
    border-width: 2px 0 2px 0;
    opacity: 0;
    pointer-events: none;
    transition: all var(--duration-nav-activate) var(--ease-nav-activate);
  }

  /* A solid plum fill, swept in behind the link on hover/active. */
  .desktop-nav a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg-elevated);
    transform: scale(0);
    pointer-events: none;
    transition: all var(--duration-nav-activate) var(--ease-nav-activate);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--color-text-primary);
  }

  .desktop-nav a:hover::before,
  .desktop-nav a[aria-current='page']::before {
    transform: scaleY(0);
    opacity: 1;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleY(1);
  }

  .desktop-nav a:active {
    scale: 0.9;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-cta {
    display: none;
  }

  .toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
  }

  .icon-close {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 1180px) {
    .desktop-nav,
    .desktop-cta {
      display: flex;
    }

    .toggle {
      display: none;
    }
  }
</style>
