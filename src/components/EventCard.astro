---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, eventStatusLabel } from '../lib/format';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, cityName, venue, date, time, description, image, imageAlt, status } = event.data;
const { day, month, weekday } = formatEventDate(date);
const href = `/events/${event.id}`;
---

<article class="card">
  <a class="card-media" href={href} aria-hidden="true" tabindex="-1">
    {image ? (
      <Image src={image} alt={imageAlt ?? ''} width={480} height={320} loading="lazy" />
    ) : (
      <div class="placeholder" role="img" aria-label={imageAlt ?? `${cityName} gathering`}>
        <span class="placeholder-city">{cityName}</span>
      </div>
    )}
    <span class="date-badge">
      <span class="date-day">{day}</span>
      <span class="date-month">{month}</span>
    </span>
  </a>

  <div class="card-body">
    <p class="meta">{weekday} · {time} · {venue}</p>
    <h3 class="title"><a href={href}>{title}</a></h3>
    <p class="description">{description}</p>

    <div class="card-footer">
      <span class="status" data-status={status}>{eventStatusLabel[status]}</span>
      <a class="rsvp" href={href}>
        RSVP
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: clip;
    transition: border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-glow-sm);
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--color-bg-deep);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    background:
      radial-gradient(120% 140% at 20% 0%, rgba(0, 159, 255, 0.14), transparent 60%),
      var(--color-bg-deep);
  }

  .placeholder-city {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .date-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    padding: var(--space-2) var(--space-3);
    background: rgba(33, 30, 45, 0.82);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .date-day {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .date-month {
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-electric-cyan);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    flex: 1;
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--text-md);
  }

  .title a {
    transition: color var(--duration-fast) var(--ease-out);
  }

  .title a:hover {
    color: var(--color-electric-cyan);
  }

  .description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .status {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .status[data-status='few-spots'] {
    color: var(--color-electric-cyan);
  }

  .status[data-status='full'] {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .rsvp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-primary);
    transition: gap var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .rsvp:hover {
    color: var(--color-electric-cyan);
    gap: var(--space-2);
  }
</style>
