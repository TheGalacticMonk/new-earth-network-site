---
import Container from '../Container.astro';
import SectionHeader from '../SectionHeader.astro';

// Structural placeholder — no fabricated testimonials or stats. Populate this grid
// with real photography, quotes, and numbers as they exist.
const tiles = Array.from({ length: 4 });
---

<section class="proof">
  <Container>
    <SectionHeader kicker="The community" heading="Stories from the circle" align="center" />
    <div class="grid" aria-hidden="true">
      {tiles.map(() => (
        <div class="tile"></div>
      ))}
    </div>
    <p class="note">Photos and stories from real gatherings will live here.</p>
  </Container>
</section>

<style>
  .proof {
    padding-block: var(--space-section);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .tile {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
    background: var(--color-bg-elevated);
  }

  .note {
    margin-top: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
