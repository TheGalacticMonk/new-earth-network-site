---
import Container from '../Container.astro';
---

<section id="subscribe" class="signup" data-tone="deep">
  <Container narrow>
    <h2 class="heading">Stay connected</h2>
    <p class="body">
      Get notified when a gathering forms near you. No noise — just the signal.
    </p>

    <!--
      No email service is wired up yet (phase 2). The form is real and accessible now;
      swap the script's fetch target for the chosen provider (e.g. a Mailchimp/ConvertKit
      endpoint) without touching markup.
    -->
    <form id="signup-form" class="form" novalidate>
      <label class="visually-hidden" for="signup-email">Email address</label>
      <input id="signup-email" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />
      <button type="submit">Notify me</button>
    </form>
    <p id="signup-status" class="status" role="status" aria-live="polite"></p>
  </Container>
</section>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const status = document.getElementById('signup-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
    if (!email) return;

    // Placeholder acknowledgment until a real signup endpoint is connected.
    if (status) status.textContent = "You're on the list. We'll be in touch.";
    form.reset();
  });
</script>

<style>
  .signup {
    padding-block: var(--space-section);
    background: var(--gradient-veil);
    text-align: center;
    /* The nav is sticky and tall — without this, jumping here via #subscribe (the
       nav's Subscribe button) would land the heading half-hidden underneath it. */
    scroll-margin-top: var(--nav-height);
  }

  .heading {
    font-size: var(--text-xl);
  }

  .body {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .form {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 420px;
    margin-inline: auto;
  }

  input {
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  button {
    padding: var(--space-4);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-bg-deep);
    background: var(--color-electric-cyan);
    border-radius: var(--radius-sm);
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  button:hover {
    box-shadow: var(--shadow-glow-md);
  }

  .status {
    margin-top: var(--space-4);
    min-height: 1.5em;
    color: var(--color-electric-cyan);
    font-size: var(--text-sm);
  }

  @media (min-width: 540px) {
    .form {
      flex-direction: row;
    }

    input {
      flex: 1;
    }

    button {
      flex-shrink: 0;
    }
  }
</style>
