---
import Container from '../Container.astro';
---

<section class="manifesto">
  <Container narrow>
    <p class="kicker">Why we exist</p>
    <p class="statement">
      For years, the internet did what it promised — it helped scattered, searching
      people find each other. <span class="highlight">That job is done.</span> The next
      one is older than any platform: sitting across from someone, in a room, in real time.
    </p>
    <p class="statement-sub">
      New Earth Network exists to turn digital recognition into physical presence —
      one gathering, one city, one circle at a time.
    </p>
  </Container>
</section>

<style>
  .manifesto {
    padding-block: var(--space-section);
    /* Below-the-fold — see Offerings.astro's .offerings rule for the full
       rationale (this cut mobile LCP's dominant main-thread style/layout
       cost, not a network fix). Height barely moves between mobile and
       desktop here (529px/520px measured), so one placeholder value covers
       both without needing a breakpoint override. */
    content-visibility: auto;
    contain-intrinsic-size: auto 525px;
  }

  .kicker {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-electric-cyan);
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    text-align: center;
  }

  .highlight {
    color: var(--color-electric-cyan);
  }

  .statement-sub {
    margin-top: var(--space-8);
    font-size: var(--text-md);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
