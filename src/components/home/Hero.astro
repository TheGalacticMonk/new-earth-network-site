---
import Container from '../Container.astro';
---

<section class="hero">
  <Container>
    <div class="hero-grid">
      <div class="tv-container">
        <div class="tv-screen">
          <div class="static" aria-hidden="true"></div>
          <div class="tv-content">
            <h1 class="headline">The revolution will not be televised.</h1>
            <p class="promise">The multidimensional human experience, online and offline.</p>
            <div class="tagline">
              <p class="subhead">Enter your email to get started.</p>
              <span class="wand" aria-hidden="true"></span>
            </div>

            <!--
              No email service is wired up yet (phase 2) — same placeholder pattern as
              EmailSignup.astro. The form is real and accessible now; swap the script's
              fetch target for the chosen provider without touching markup. IDs are
              prefixed hero- since EmailSignup's own form renders further down this
              same page.
            -->
            <form id="hero-signup-form" class="form" novalidate>
              <label class="visually-hidden" for="hero-signup-email">Email address</label>
              <div class="field-group">
                <input
                  id="hero-signup-email"
                  name="email"
                  type="email"
                  placeholder="you@example.com"
                  required
                  autocomplete="email"
                />
                <button type="submit">Get Started</button>
              </div>
            </form>
            <p id="hero-signup-status" class="status" role="status" aria-live="polite"></p>
          </div>
        </div>
        <div class="tv-stand" aria-hidden="true"></div>
      </div>

      <div class="hero-visual">
        <div class="earth" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById('hero-signup-form') as HTMLFormElement | null;
  const status = document.getElementById('hero-signup-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
    if (!email) return;

    // Placeholder acknowledgment until a real signup endpoint is connected.
    if (status) status.textContent = "You're on the list. We'll be in touch.";
    form.reset();
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    /* Split rather than a single `gap`: below the 900px breakpoint this is a
       single column, so `gap` is entirely row-gap — the space between the
       form and the globe. --space-12 read fine as a column gutter (desktop)
       but as a stacking gap it pushed the globe past the fold on common
       phone viewport heights, with nothing below it to balance the space
       above it. Row-gap only ever applies in the single-column case, and
       column-gap only once the 900px breakpoint below switches to two
       columns, so this is the whole fix — no media query needed. */
    row-gap: var(--space-6);
    column-gap: var(--space-12);
    /* Grid items default to min-width: auto, which lets an unbreakable line of
       text (the headline, at 320px) force the whole track — and the page —
       wider than the viewport instead of wrapping. Same fix on .tv-content
       below, two levels in. */
    min-width: 0;
  }

  /* The email-capture card, tried as a TV screen instead — a raw HTML/CSS
     template (site owner's pick, New Earth Network positioning itself like a
     TV network) with its placeholder ERROR/static screen swapped for the
     card's real content. The bezel, screen background, corner radius and
     both shadows below are the template's own literal values (see
     --color-tv-bezel and --shadow-tv-screen/--shadow-tv-stand in
     tokens.css) — untouched except where the fixed 300x200px screen had to
     become fluid to actually hold a headline, copy and a form instead of one
     line of placeholder text.

     The template's static layer is back too (.static below), sitting behind
     .tv-content exactly the way its .error-text sat over the template's
     .static — same z-index relationship, form on top instead of the literal
     ERROR text. What isn't reused verbatim is the timing: the template ran
     its flicker at 0.1s steps(20) infinite, 10 cycles/sec, which fails WCAG
     2.3.1's three-flashes ceiling. --duration-tv-static-flicker in
     tokens.css stretches the same opacity/scaleY pulse to 2.4s so it reads
     as a slow shimmer rather than a strobe; the site's global
     prefers-reduced-motion rule (global.css) then collapses it to a single
     static frame for anyone who's asked for less motion. No separate glitch
     skew on the form — that would visibly jitter the email input, which is
     a usability problem the template's placeholder text never had to
     worry about. */
  .tv-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .tv-screen {
    position: relative;
    width: 100%;
    max-width: var(--hero-content-max);
    background: var(--color-tv-screen-bg);
    border: 10px solid var(--color-tv-bezel);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-tv-screen);
    overflow: hidden;
  }

  /* The template's noise texture, slowed — see the .tv-container comment
     above for why this doesn't reuse the template's 0.1s cycle. Also dimmed:
     the template only ever showed this at full strength behind one line of
     bold placeholder text with a heavy shadow. Behind this card's real
     headline, body copy and form, full-contrast stripes sitting right behind
     unshadowed running text would undercut the exact text contrast the
     site's WCAG 2.2 AA floor requires — 0.14 keeps the texture readable as
     "this is a TV screen" without competing with the content sitting on it. */
  .static {
    position: absolute;
    inset: 0;
    background: var(--gradient-tv-static);
    opacity: 0.14;
    animation: tv-static-flicker var(--duration-tv-static-flicker) ease-in-out infinite;
    z-index: 1;
  }

  .tv-content {
    position: relative;
    /* Above .static, same relationship as the template's .error-text over
       its .static. */
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    min-width: 0;
    container-type: inline-size;
    font-family: var(--font-hero);
    font-weight: var(--font-weight-regular);
    padding: var(--space-8) var(--space-6);
  }

  .tv-stand {
    width: 150px;
    height: 10px;
    background: var(--color-tv-bezel);
    margin-top: 10px;
    border-radius: 5px;
    box-shadow: var(--shadow-tv-stand);
  }

  .headline {
    width: 100%;
    /* No manual <br> in this copy (unlike the old two-clause version) — let
       the browser pick the break itself. balance (not the plain "wrap" this
       used before) is what keeps a single sentence like this from stranding
       one short word alone on its own line. */
    text-wrap: balance;
    /* Now matched to OfferingCard.astro's .title instead — its own third
       reference in as many passes (first --font-hero, then "Upcoming
       gatherings"'s --font-display/600, now the offering cards' gradient-
       text treatment), at the site owner's explicit request this time.
       .title's font-family is just inherited body text (Manrope, no
       override in that file) — --font-body here is the same thing named
       directly rather than left implicit. */
    font-family: var(--font-body);
    /* Kept at --text-lg rather than .title's literal 18px: this is still an
       <h1>, and this site's own sizing work over several passes (--text-hero
       down to --text-xl down to --text-lg, each step justified against how
       loud the headline read) isn't undone by a styling match — "same font
       and styling" was about the treatment, not shrinking the hero's one
       headline to a small card label's point size. */
    font-size: var(--text-lg);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 3px;
    line-height: 1.3;
    /* Gradient-text fill + glow, identical values to .title (now shared via
       --gradient-card-title and its neighbors in tokens.css) — replaces the
       flat --color-text-body this had before. */
    background: var(--gradient-card-title);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 15px var(--color-card-title-glow));
    text-shadow:
      0 0 10px var(--color-card-title-shadow),
      0 0 20px var(--color-card-title-shadow-wide);
    /* Belt-and-suspenders alongside the min-width: 0 fixes above — if a single
       word ever doesn't fit even after those, wrap it rather than overflow. */
    overflow-wrap: break-word;
  }

  .promise {
    /* Matched to OfferingCard.astro's .description font specifically (the
       site owner's ask) — that element never sets its own font-family
       either, it's the same inherited Manrope every unstyled element on the
       page gets, named directly here as --font-body rather than through
       --font-hero (still system-ui, still used by .subhead/input/button —
       this was scoped to just the line under the headline). Size, weight,
       line-height and color untouched: only the font itself was asked for. */
    font-family: var(--font-body);
    font-size: var(--text-hero-promise);
    line-height: var(--leading-snug);
    color: var(--color-text-body);
    text-wrap: balance;
    /* Same glow as .headline, values unchanged — not the gradient text-fill
       alongside it, since that's a bigger ask ("same styling") than what was
       actually requested here ("the same glow effect"). filter and
       text-shadow both work independent of a solid vs. gradient fill, so
       this layers the identical glow over .promise's own existing colour
       rather than requiring the gradient to come with it. */
    filter: drop-shadow(0 0 15px var(--color-card-title-glow));
    text-shadow:
      0 0 10px var(--color-card-title-shadow),
      0 0 20px var(--color-card-title-shadow-wide);
    /* On top of .tv-content's --space-2 floor: 16px total under the
       headline — close enough to read as the same "pitch" unit, not the
       bare 8px minimum every other gap not otherwise adjusted would get. */
    margin-top: var(--space-2);
  }

  /* The smaller email prompt keeps its wand alongside it, both now centered
     as a unit to match .tv-content's centered alignment. */
  .tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* The one deliberately large gap in the card: on top of the --space-2
       floor, 32px total above .tagline — the seam between the pitch
       (headline + promise) and the action (prompt + form), and not a
       coincidence that it lands on the same number as --space-8, this
       card's own outer padding: a gap that echoes the card's own margin
       reads as a considered break, not an arbitrary bigger number. */
    margin-top: var(--space-6);
  }

  /* Preserve the supplied silhouette, with a quiet patch of sky behind it so
     background stars cannot read as extra points on the wand's small diamonds. */
  .wand {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    width: var(--hero-wand-size);
    height: var(--hero-wand-size);
  }

  .wand::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--hero-wand-clearance));
    backdrop-filter: blur(var(--hero-wand-backdrop-blur));
    mask-image: var(--hero-wand-backdrop-mask);
    pointer-events: none;
  }

  .wand::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-electric-gold);
    mask: url('/wand_stars.svg') center / contain no-repeat;
  }

  .subhead {
    font-family: var(--font-hero);
    font-size: var(--text-hero-subhead);
    color: var(--color-text-muted);
    /* Same glow as .headline/.promise — see .promise's own comment for why
       this is the glow alone, not the gradient fill it rides on for the
       headline. */
    filter: drop-shadow(0 0 15px var(--color-card-title-glow));
    text-shadow:
      0 0 10px var(--color-card-title-shadow),
      0 0 20px var(--color-card-title-shadow-wide);
  }

  .form {
    width: 100%;
    max-width: var(--hero-form-max);
    /* On top of the --space-2 floor: 16px total under .tagline, the same
       "tight" total .promise gets under the headline — the prompt sits
       close to its own field, like a label, not spaced as generously as the
       seam above it. */
    margin-top: var(--space-2);
  }

  .field-group {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
    width: 100%;
    background: transparent;
    border-radius: var(--radius-full);
  }

  input {
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-4);
    padding-block: var(--space-3);
    /* Reset the browser's own default text-field chrome (a rectangular inset
       border/appearance) — without this, that native border shows at rest and
       only gets masked once focus-visible's outline takes over, making the
       resting field look like a mistake rather than part of the pill. */
    appearance: none;
    border: none;
    border-radius: var(--radius-full);
    /* A genuinely grey fill (not another shade of the site's near-black) so the
       field reads as its own distinct, easy-to-spot control rather than one
       undifferentiated dark bar running straight into the button. */
    background: var(--color-field-grey);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    min-height: var(--target-min);
    /* At narrow widths the fixed-size button leaves little room for the input;
       ellipsize rather than hard-clip so a partially visible placeholder reads
       as intentional truncation, not a layout bug. */
    text-overflow: ellipsis;
  }

  input:focus-visible {
    border-radius: var(--radius-full);
    outline-offset: -2px;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  button {
    min-height: var(--target-min);
    flex-shrink: 0;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-hero);
    /* Bold (700), matching the form template's .card__form button exactly —
       see --font-weight-bold in tokens.css. */
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    /* Solid cyan fill with dark text first, now a cyan-glass fill with a
       cyan ring instead — same border weight as the nav Subscribe button
       (--cta-border-width) so the site's two primary CTAs read as one
       family. Text moved to --color-text-primary because the fill is no
       longer solid and bright enough for dark text to hold contrast. */
    color: var(--color-text-primary);
    background: var(--color-hero-cta-fill);
    border: var(--cta-border-width) solid var(--color-electric-cyan);
    border-radius: var(--radius-full);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  button:hover {
    box-shadow: var(--shadow-glow-md);
    transform: translateY(-1px);
  }

  button:active {
    transform: translateY(0);
  }

  .status {
    min-height: 1.5em;
    color: var(--color-electric-cyan);
    font-size: var(--text-sm);
  }

  /* Same three keyframe stops as the template's own @keyframes flicker,
     just riding --duration-tv-static-flicker instead of its 0.1s. */
  @keyframes tv-static-flicker {
    0% {
      opacity: 0.8;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.01);
    }
    100% {
      opacity: 0.7;
      transform: scaleY(0.99);
    }
  }

  /* Size the layout box and its lighting together so the globe stays in its
     column, including immediately after the two-column breakpoint.

     This is the plain, single-element version — background-position pan +
     inset box-shadow lighting on one div — not the later three-layer
     compositor-only rebuild (image on its own transform-animated layer,
     lighting moved to a ::after so it paints on top instead of underneath).
     That rebuild fixed a real defect (background-position forces a main-
     thread repaint every frame, on every device, for the entire 30s loop —
     confirmed via Lighthouse's non-composited-animations audit), but it read
     as lower quality on screen, so this is back at the site owner's request
     while the font-loading problem (the audit's other, larger finding —
     mobile LCP 2.03s against a 1.2s budget, from render-blocking CSS + 3
     web-font families) gets tackled first. */
  .earth {
    font-size: var(--hero-earth-size);
    width: 1em;
    height: 1em;
    margin-inline: auto;
    border-radius: 50%;
    background: url('/images/earth.jpg');
    background-size: cover;
    background-position: left;
    box-shadow: var(--hero-earth-shadow);
    animation: earth-rotate var(--hero-earth-duration) linear infinite;
  }

  @keyframes earth-rotate {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: var(--hero-earth-travel) 0;
    }
  }

  @media (max-width: 479px) {
    /* --text-lg's own floor (1.5rem/24px) doesn't shrink any further below
       this breakpoint, but at that size + the desktop 3px letter-spacing the
       headline was crowding three lines out of its available width. The
       first fix (--text-sm, 15px) solved that but created a new problem,
       found afterward: nothing else in the card shrinks on mobile, so the
       headline — meant to be the most prominent thing in the card — ended up
       SMALLER than .promise (20px) and .subhead/input (17px). An <h1>
       reading smaller than its own supporting text is exactly the
       "uncohesive" feeling that's being fixed here, not just a too-small
       number in isolation.

       19px is the fix: the largest size that still holds two lines at every
       width down to 320px, but ONLY once letter-spacing also comes down from
       the desktop 3px to 1.5px alongside it — tracking that wide was costing
       real width that a mobile line can't spare. Reducing both together,
       rather than only shrinking font-size further, is what gets the
       headline back above the rest of the card's text instead of still
       being boxed in by the same tracking that caused the wrap in the first
       place.

       This still holds for "The revolution will not be televised." — a
       single sentence now (no manual <br>), left to text-wrap: balance to
       break on its own. Re-verified at 320/380/479/480/500/899/1920px: holds
       a clean two-line balanced break the whole way, same floor as before
       below 320px. */
    .headline {
      font-size: 19px;
      letter-spacing: 1.5px;
    }

    /* .promise's 20px is a fixed value, not a fluid clamp, so it never came
       down on its own — matched to .subhead/input's own --text-base (17px)
       here so the "pitch" and "action" halves of the card share one
       secondary size instead of introducing a third, while the headline
       above stays clearly the largest at 19px. */
    .promise {
      font-size: var(--text-base);
    }

    /* Keep the supporting sentence and its flourish together on narrow screens. */
    .tagline {
      gap: var(--space-1);
    }

    .wand {
      width: var(--hero-wand-size-compact);
      height: var(--hero-wand-size-compact);
    }

    .field-group {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .earth {
      font-size: var(--hero-earth-size-desktop);
    }
  }
</style>
