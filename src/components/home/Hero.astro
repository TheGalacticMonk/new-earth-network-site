---
import Container from '../Container.astro';
---

<section class="hero">
  <Container>
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="headline">Become the New Earth.<br />Connect your frequency.</h1>
        <p class="promise">The multidimensional human experience, online and offline.</p>
        <div class="tagline">
          <p class="subhead">Enter your email to get started.</p>
          <span class="wand" aria-hidden="true"></span>
        </div>

        <!--
          No email service is wired up yet (phase 2) — same placeholder pattern as
          EmailSignup.astro. The form is real and accessible now; swap the script's
          fetch target for the chosen provider without touching markup. IDs are
          prefixed hero- since EmailSignup's own form renders further down this
          same page.
        -->
        <form id="hero-signup-form" class="form" novalidate>
          <label class="visually-hidden" for="hero-signup-email">Email address</label>
          <div class="field-group">
            <input
              id="hero-signup-email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
              autocomplete="email"
            />
            <button type="submit">Get Started</button>
          </div>
        </form>
        <p id="hero-signup-status" class="status" role="status" aria-live="polite"></p>
      </div>

      <div class="hero-visual">
        <div class="earth" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById('hero-signup-form') as HTMLFormElement | null;
  const status = document.getElementById('hero-signup-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
    if (!email) return;

    // Placeholder acknowledgment until a real signup endpoint is connected.
    if (status) status.textContent = "You're on the list. We'll be in touch.";
    form.reset();
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    /* Split rather than a single `gap`: below the 900px breakpoint this is a
       single column, so `gap` is entirely row-gap — the space between the
       form and the globe. --space-12 read fine as a column gutter (desktop)
       but as a stacking gap it pushed the globe past the fold on common
       phone viewport heights, with nothing below it to balance the space
       above it. Row-gap only ever applies in the single-column case, and
       column-gap only once the 900px breakpoint below switches to two
       columns, so this is the whole fix — no media query needed. */
    row-gap: var(--space-6);
    column-gap: var(--space-12);
    /* Grid items default to min-width: auto, which lets an unbreakable line of
       text (the headline, at 320px) force the whole track — and the page —
       wider than the viewport instead of wrapping. Same fix on .hero-content
       below, one level in. */
    min-width: 0;
  }

  /* Same glass-fill-plus-gradient-ring family as HeartSignalButton's
     .signal-btn and this form's own "Get Started" button (see
     HeartSignalButton.astro for the mask-technique reasoning), with one
     deliberate difference: --gradient-hero-ring has a transparent lead-in,
     so the ring isn't a fully closed loop — see tokens.css for why that's
     the specific thing the site owner wanted from their template, not its
     colors or its fully-opaque ring. */
  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Trying centered as an experiment (site owner's call, exploring whether
       it reads better now that the card's own left edge is deliberately
       aligned with the nav logo/ring seam — that alignment is about the
       CARD's outer position, unaffected by how its own contents are
       arranged inside it). Was align-items: flex-start / text-align: left,
       "one content rail at every viewport, shared with the navigation logo." */
    align-items: center;
    /* Rhythm redesigned around what the five children actually ARE, not one
       uniform number: .headline + .promise are one unit (the pitch),
       .tagline + .form + .status are another (the action) — they shouldn't
       read as five equally-spaced items in a list. --space-2 is the floor
       gap every adjacent pair gets by default; .promise and .tagline below
       each add their own margin-top on top of it to open up exactly where
       the composition needs air, not everywhere equally. */
    gap: var(--space-2);
    text-align: center;
    width: 100%;
    max-width: var(--hero-content-max);
    min-width: 0;
    container-type: inline-size;
    font-family: var(--font-hero);
    font-weight: var(--font-weight-regular);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-signal-btn-fill);
    /* Apple-style frosted glass: unlike the Subscribe button, which borrows its
       blur from sitting under the nav's own backdrop-filter layer (see
       --color-signal-btn-fill in tokens.css), this card is out in the open page
       body with nothing blurring the nebula/stars behind it — so it needs its
       own backdrop-filter to read as glass rather than a flat tinted panel.
       Saturate alongside the blur, not just blur alone, since that boosted
       vibrancy of whatever shows through is what actually reads as "Apple
       glass" rather than generic frosted CSS — a plain blur under the same fill
       looks closer to smoked plastic. Values hardcoded to match the nav's own
       unwrapped blur(10px) precedent (Navigation.astro) rather than tokenized,
       since STANDARDS.md's no-hard-coded-values rule is about colour, not
       filter magnitudes. */
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    /* Two more glass cues on top of the frost itself: an inset top highlight
       (light catching the inside of the glass' upper edge — see
       --color-glass-highlight in tokens.css) and --shadow-float, the same
       outer lift token HeartSignalButton uses, so the card reads as a pane
       sitting above the nebula rather than painted onto it. No colour-glow
       layer alongside it the way the button pairs --shadow-float with
       --shadow-signal-glow: that combination is tuned for a small, discrete
       control, and at this card's size a matching glow would wash out into
       ambient light competing with the ring and the earth's own glow instead
       of reading as a deliberate accent. */
    box-shadow:
      inset 0 1px 0 var(--color-glass-highlight),
      var(--shadow-float);
  }

  .hero-content::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--cta-border-width);
    background: var(--gradient-hero-ring);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .headline {
    width: 100%;
    text-wrap: wrap;
    /* Now matched to OfferingCard.astro's .title instead — its own third
       reference in as many passes (first --font-hero, then "Upcoming
       gatherings"'s --font-display/600, now the offering cards' gradient-
       text treatment), at the site owner's explicit request this time.
       .title's font-family is just inherited body text (Manrope, no
       override in that file) — --font-body here is the same thing named
       directly rather than left implicit. */
    font-family: var(--font-body);
    /* Kept at --text-lg rather than .title's literal 18px: this is still an
       <h1>, and this site's own sizing work over several passes (--text-hero
       down to --text-xl down to --text-lg, each step justified against how
       loud the headline read) isn't undone by a styling match — "same font
       and styling" was about the treatment, not shrinking the hero's one
       headline to a small card label's point size. */
    font-size: var(--text-lg);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 3px;
    line-height: 1.3;
    /* Gradient-text fill + glow, identical values to .title (now shared via
       --gradient-card-title and its neighbors in tokens.css) — replaces the
       flat --color-text-body this had before. */
    background: var(--gradient-card-title);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 15px var(--color-card-title-glow));
    text-shadow:
      0 0 10px var(--color-card-title-shadow),
      0 0 20px var(--color-card-title-shadow-wide);
    /* Belt-and-suspenders alongside the min-width: 0 fixes above — if a single
       word ever doesn't fit even after those, wrap it rather than overflow. */
    overflow-wrap: break-word;
  }

  .promise {
    /* Matched to OfferingCard.astro's .description font specifically (the
       site owner's ask) — that element never sets its own font-family
       either, it's the same inherited Manrope every unstyled element on the
       page gets, named directly here as --font-body rather than through
       --font-hero (still system-ui, still used by .subhead/input/button —
       this was scoped to just the line under the headline). Size, weight,
       line-height and color untouched: only the font itself was asked for. */
    font-family: var(--font-body);
    font-size: var(--text-hero-promise);
    line-height: var(--leading-snug);
    color: var(--color-text-body);
    text-wrap: balance;
    /* On top of .hero-content's --space-2 floor: 16px total under the
       headline — close enough to read as the same "pitch" unit, not the
       bare 8px minimum every other gap not otherwise adjusted would get. */
    margin-top: var(--space-2);
  }

  /* The smaller email prompt keeps its wand alongside it, both now centered
     as a unit to match .hero-content's experimental center alignment. */
  .tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* The one deliberately large gap in the card: on top of the --space-2
       floor, 32px total above .tagline — the seam between the pitch
       (headline + promise) and the action (prompt + form), and not a
       coincidence that it lands on the same number as --space-8, this
       card's own outer padding: a gap that echoes the card's own margin
       reads as a considered break, not an arbitrary bigger number. */
    margin-top: var(--space-6);
  }

  /* Preserve the supplied silhouette, with a quiet patch of sky behind it so
     background stars cannot read as extra points on the wand's small diamonds. */
  .wand {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    width: var(--hero-wand-size);
    height: var(--hero-wand-size);
  }

  .wand::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--hero-wand-clearance));
    backdrop-filter: blur(var(--hero-wand-backdrop-blur));
    mask-image: var(--hero-wand-backdrop-mask);
    pointer-events: none;
  }

  .wand::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-electric-gold);
    mask: url('/wand_stars.svg') center / contain no-repeat;
  }

  .subhead {
    font-family: var(--font-hero);
    font-size: var(--text-hero-subhead);
    color: var(--color-text-muted);
  }

  .form {
    width: 100%;
    max-width: var(--hero-form-max);
    /* On top of the --space-2 floor: 16px total under .tagline, the same
       "tight" total .promise gets under the headline — the prompt sits
       close to its own field, like a label, not spaced as generously as the
       seam above it. */
    margin-top: var(--space-2);
  }

  .field-group {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
    width: 100%;
    background: transparent;
    border-radius: var(--radius-full);
  }

  input {
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-4);
    padding-block: var(--space-3);
    /* Reset the browser's own default text-field chrome (a rectangular inset
       border/appearance) — without this, that native border shows at rest and
       only gets masked once focus-visible's outline takes over, making the
       resting field look like a mistake rather than part of the pill. */
    appearance: none;
    border: none;
    border-radius: var(--radius-full);
    /* A genuinely grey fill (not another shade of the site's near-black) so the
       field reads as its own distinct, easy-to-spot control rather than one
       undifferentiated dark bar running straight into the button. */
    background: var(--color-field-grey);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    min-height: var(--target-min);
    /* At narrow widths the fixed-size button leaves little room for the input;
       ellipsize rather than hard-clip so a partially visible placeholder reads
       as intentional truncation, not a layout bug. */
    text-overflow: ellipsis;
  }

  input:focus-visible {
    border-radius: var(--radius-full);
    outline-offset: -2px;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  button {
    min-height: var(--target-min);
    flex-shrink: 0;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-hero);
    /* Bold (700), matching the form template's .card__form button exactly —
       see --font-weight-bold in tokens.css. */
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    /* Solid cyan fill with dark text first, now a cyan-glass fill with a
       cyan ring instead — same border weight as the nav Subscribe button
       (--cta-border-width) so the site's two primary CTAs read as one
       family. Text moved to --color-text-primary because the fill is no
       longer solid and bright enough for dark text to hold contrast. */
    color: var(--color-text-primary);
    background: var(--color-hero-cta-fill);
    border: var(--cta-border-width) solid var(--color-electric-cyan);
    border-radius: var(--radius-full);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  button:hover {
    box-shadow: var(--shadow-glow-md);
    transform: translateY(-1px);
  }

  button:active {
    transform: translateY(0);
  }

  .status {
    min-height: 1.5em;
    color: var(--color-electric-cyan);
    font-size: var(--text-sm);
  }

  /* Size the layout box and its lighting together so the globe stays in its
     column, including immediately after the two-column breakpoint. */
  .earth {
    font-size: var(--hero-earth-size);
    width: 1em;
    height: 1em;
    margin-inline: auto;
    border-radius: 50%;
    background: url('/images/earth.jpg');
    background-size: cover;
    background-position: left;
    box-shadow: var(--hero-earth-shadow);
    animation: earth-rotate var(--hero-earth-duration) linear infinite;
  }

  @keyframes earth-rotate {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: var(--hero-earth-travel) 0;
    }
  }

  @media (max-width: 479px) {
    /* --text-lg's own floor (1.5rem/24px) doesn't shrink any further below
       this breakpoint, but the headline's two <br>-separated lines each need
       real room to stay at two lines (see the git history on this rule for
       the original measurement of why). The first fix (--text-sm, 15px) hit
       that target but created a new problem, found afterward: nothing else
       in the card shrinks on mobile, so the headline — meant to be the most
       prominent thing in the card — ended up SMALLER than .promise (20px)
       and .subhead/input (17px). An <h1> reading smaller than its own
       supporting text is exactly the "uncohesive" feeling that's being fixed
       here, not just a too-small number in isolation.

       19px is the fix: the largest size that still holds two lines at every
       width from 360-479px, but ONLY once letter-spacing also comes down
       from the desktop 3px to 1.5px alongside it — tracking that wide was
       costing real width (roughly (character count - 1) x 3px per line,
       ~63-69px on this copy) that a mobile line can't spare. Reducing both
       together, rather than only shrinking font-size further, is what gets
       the headline back above the rest of the card's text instead of still
       being boxed in by the same tracking that caused the wrap in the first
       place. Verified at 320/340/360/390/414/430/460/479px — holds two
       lines 360px up, same graceful-degradation floor as before below that
       (see the same git history). */
    .headline {
      font-size: 19px;
      letter-spacing: 1.5px;
    }

    /* .promise's 20px is a fixed value, not a fluid clamp, so it never came
       down on its own — matched to .subhead/input's own --text-base (17px)
       here so the "pitch" and "action" halves of the card share one
       secondary size instead of introducing a third, while the headline
       above stays clearly the largest at 19px. */
    .promise {
      font-size: var(--text-base);
    }

    /* Keep the supporting sentence and its flourish together on narrow screens. */
    .tagline {
      gap: var(--space-1);
    }

    .wand {
      width: var(--hero-wand-size-compact);
      height: var(--hero-wand-size-compact);
    }

    .field-group {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .earth {
      font-size: var(--hero-earth-size-desktop);
    }
  }
</style>
