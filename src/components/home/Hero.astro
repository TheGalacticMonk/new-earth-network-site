---
import Container from '../Container.astro';
---

<section class="hero">
  <Container>
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="headline">Become the New Earth.<br />Connect your frequency.</h1>
        <p class="promise">The complete human experience, online and offline.</p>
        <div class="tagline">
          <p class="subhead">Enter your email to get started.</p>
          <span class="wand" aria-hidden="true"></span>
        </div>

        <!--
          No email service is wired up yet (phase 2) — same placeholder pattern as
          EmailSignup.astro. The form is real and accessible now; swap the script's
          fetch target for the chosen provider without touching markup. IDs are
          prefixed hero- since EmailSignup's own form renders further down this
          same page.
        -->
        <form id="hero-signup-form" class="form" novalidate>
          <label class="visually-hidden" for="hero-signup-email">Email address</label>
          <div class="field-group">
            <input
              id="hero-signup-email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
              autocomplete="email"
            />
            <button type="submit">Get Started</button>
          </div>
        </form>
        <p id="hero-signup-status" class="status" role="status" aria-live="polite"></p>
      </div>

      <div class="hero-visual">
        <div class="earth" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById('hero-signup-form') as HTMLFormElement | null;
  const status = document.getElementById('hero-signup-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
    if (!email) return;

    // Placeholder acknowledgment until a real signup endpoint is connected.
    if (status) status.textContent = "You're on the list. We'll be in touch.";
    form.reset();
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    /* Split rather than a single `gap`: below the 900px breakpoint this is a
       single column, so `gap` is entirely row-gap — the space between the
       form and the globe. --space-12 read fine as a column gutter (desktop)
       but as a stacking gap it pushed the globe past the fold on common
       phone viewport heights, with nothing below it to balance the space
       above it. Row-gap only ever applies in the single-column case, and
       column-gap only once the 900px breakpoint below switches to two
       columns, so this is the whole fix — no media query needed. */
    row-gap: var(--space-6);
    column-gap: var(--space-12);
    /* Grid items default to min-width: auto, which lets an unbreakable line of
       text (the headline, at 320px) force the whole track — and the page —
       wider than the viewport instead of wrapping. Same fix on .hero-content
       below, one level in. */
    min-width: 0;
  }

  /* Same glass-fill-plus-gradient-ring family as HeartSignalButton's
     .signal-btn and this form's own "Get Started" button (see
     HeartSignalButton.astro for the mask-technique reasoning), with one
     deliberate difference: --gradient-hero-ring has a transparent lead-in,
     so the ring isn't a fully closed loop — see tokens.css for why that's
     the specific thing the site owner wanted from their template, not its
     colors or its fully-opaque ring. */
  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    /* One content rail at every viewport, shared with the navigation logo. */
    align-items: flex-start;
    gap: var(--space-6);
    text-align: left;
    width: 100%;
    max-width: var(--hero-content-max);
    min-width: 0;
    container-type: inline-size;
    font-family: var(--font-hero);
    font-weight: var(--font-weight-regular);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-signal-btn-fill);
    /* Apple-style frosted glass: unlike the Subscribe button, which borrows its
       blur from sitting under the nav's own backdrop-filter layer (see
       --color-signal-btn-fill in tokens.css), this card is out in the open page
       body with nothing blurring the nebula/stars behind it — so it needs its
       own backdrop-filter to read as glass rather than a flat tinted panel.
       Saturate alongside the blur, not just blur alone, since that boosted
       vibrancy of whatever shows through is what actually reads as "Apple
       glass" rather than generic frosted CSS — a plain blur under the same fill
       looks closer to smoked plastic. Values hardcoded to match the nav's own
       unwrapped blur(10px) precedent (Navigation.astro) rather than tokenized,
       since STANDARDS.md's no-hard-coded-values rule is about colour, not
       filter magnitudes. */
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    /* Two more glass cues on top of the frost itself: an inset top highlight
       (light catching the inside of the glass' upper edge — see
       --color-glass-highlight in tokens.css) and --shadow-float, the same
       outer lift token HeartSignalButton uses, so the card reads as a pane
       sitting above the nebula rather than painted onto it. No colour-glow
       layer alongside it the way the button pairs --shadow-float with
       --shadow-signal-glow: that combination is tuned for a small, discrete
       control, and at this card's size a matching glow would wash out into
       ambient light competing with the ring and the earth's own glow instead
       of reading as a deliberate accent. */
    box-shadow:
      inset 0 1px 0 var(--color-glass-highlight),
      var(--shadow-float);
  }

  .hero-content::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--cta-border-width);
    background: var(--gradient-hero-ring);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .headline {
    width: 100%;
    text-wrap: wrap;
    /* Deliberately NOT --font-hero (the rest of the card is still on that) —
       the site owner's call was specifically for the headline to match
       "Upcoming gatherings" (UpcomingGatherings.astro, via SectionHeader.astro),
       which never sets its own font: it's a plain <h2>, inheriting
       --font-display + weight 600 from global.css's shared h1-h4 rule. Same
       family and weight here, matched directly rather than piggybacked on
       that inheritance, since .headline is an actual <h1> and global.css
       bumps bare h1s to weight 700 with tighter tracking — this reproduces
       how the h2 specifically looks, not how a default h1 would. */
    font-family: var(--font-display);
    /* Down from --text-hero (clamp(2rem, 1.25rem + 3.5cqi, 3.25rem)), first
       to --text-xl (matching "Upcoming gatherings" exactly) and now one more
       step down to --text-lg (clamp(1.5rem, 1.3rem + 1vw, 2rem)) — even
       --text-xl, though numerically the same size as that section heading,
       read as more demanding here: the hero card is a much narrower, more
       enclosed box than a full-width page section, so the identical pixel
       size fills far more of its own container and reads as louder. This is
       no longer a literal match to "Upcoming gatherings" — it's calmer than
       that reference on purpose, sized for the smaller room it's actually in. */
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-normal);
    /* Softer than the sitewide heading white (--color-text-primary) — at hero
       scale, full white read as too stark against the rest of the muted
       palette. */
    color: var(--color-text-body);
    /* Belt-and-suspenders alongside the min-width: 0 fixes above — if a single
       word ever doesn't fit even after those, wrap it rather than overflow. */
    overflow-wrap: break-word;
  }

  .promise {
    font-family: var(--font-hero);
    font-size: var(--text-hero-promise);
    line-height: var(--leading-snug);
    color: var(--color-text-body);
    text-wrap: balance;
  }

  /* The smaller email prompt keeps its wand and the shared content rail. */
  .tagline {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-2);
  }

  /* Preserve the supplied silhouette, with a quiet patch of sky behind it so
     background stars cannot read as extra points on the wand's small diamonds. */
  .wand {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    width: var(--hero-wand-size);
    height: var(--hero-wand-size);
  }

  .wand::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--hero-wand-clearance));
    backdrop-filter: blur(var(--hero-wand-backdrop-blur));
    mask-image: var(--hero-wand-backdrop-mask);
    pointer-events: none;
  }

  .wand::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-electric-gold);
    mask: url('/wand_stars.svg') center / contain no-repeat;
  }

  .subhead {
    font-family: var(--font-hero);
    font-size: var(--text-hero-subhead);
    color: var(--color-text-muted);
  }

  .form {
    width: 100%;
    max-width: var(--hero-form-max);
    margin-top: var(--space-2);
  }

  .field-group {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
    width: 100%;
    background: transparent;
    border-radius: var(--radius-full);
  }

  input {
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-4);
    padding-block: var(--space-3);
    /* Reset the browser's own default text-field chrome (a rectangular inset
       border/appearance) — without this, that native border shows at rest and
       only gets masked once focus-visible's outline takes over, making the
       resting field look like a mistake rather than part of the pill. */
    appearance: none;
    border: none;
    border-radius: var(--radius-full);
    /* A genuinely grey fill (not another shade of the site's near-black) so the
       field reads as its own distinct, easy-to-spot control rather than one
       undifferentiated dark bar running straight into the button. */
    background: var(--color-field-grey);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    min-height: var(--target-min);
    /* At narrow widths the fixed-size button leaves little room for the input;
       ellipsize rather than hard-clip so a partially visible placeholder reads
       as intentional truncation, not a layout bug. */
    text-overflow: ellipsis;
  }

  input:focus-visible {
    border-radius: var(--radius-full);
    outline-offset: -2px;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  button {
    min-height: var(--target-min);
    flex-shrink: 0;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-hero);
    /* Bold (700), matching the form template's .card__form button exactly —
       see --font-weight-bold in tokens.css. */
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    /* Solid cyan fill with dark text first, now a cyan-glass fill with a
       cyan ring instead — same border weight as the nav Subscribe button
       (--cta-border-width) so the site's two primary CTAs read as one
       family. Text moved to --color-text-primary because the fill is no
       longer solid and bright enough for dark text to hold contrast. */
    color: var(--color-text-primary);
    background: var(--color-hero-cta-fill);
    border: var(--cta-border-width) solid var(--color-electric-cyan);
    border-radius: var(--radius-full);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  button:hover {
    box-shadow: var(--shadow-glow-md);
    transform: translateY(-1px);
  }

  button:active {
    transform: translateY(0);
  }

  .status {
    min-height: 1.5em;
    color: var(--color-electric-cyan);
    font-size: var(--text-sm);
  }

  /* Size the layout box and its lighting together so the globe stays in its
     column, including immediately after the two-column breakpoint. */
  .earth {
    font-size: var(--hero-earth-size);
    width: 1em;
    height: 1em;
    margin-inline: auto;
    border-radius: 50%;
    background: url('/images/earth.jpg');
    background-size: cover;
    background-position: left;
    box-shadow: var(--hero-earth-shadow);
    animation: earth-rotate var(--hero-earth-duration) linear infinite;
  }

  @keyframes earth-rotate {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: var(--hero-earth-travel) 0;
    }
  }

  @media (max-width: 479px) {
    /* Keep the supporting sentence and its flourish together on narrow screens. */
    .tagline {
      gap: var(--space-1);
    }

    .wand {
      width: var(--hero-wand-size-compact);
      height: var(--hero-wand-size-compact);
    }

    .field-group {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .earth {
      font-size: var(--hero-earth-size-desktop);
    }
  }
</style>
