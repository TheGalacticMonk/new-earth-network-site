---
import Container from '../Container.astro';
import OfferingCard from '../OfferingCard.astro';

/*
  Same left-to-right order as the nav (Navigation.astro's `links`) — Events,
  Series, Docs & Films, Music, Courses, Shop. Card copy is just each name for
  now, plus a reserved (currently unfilled) `description` slot per card — see
  OfferingCard.astro's header comment. The neon palette is still the next pass.
*/
const cards = [
  { icon: '/events.svg', label: 'EVENTS' },
  { icon: '/series.svg', label: 'SERIES' },
  { icon: '/docsfilms.svg', label: 'DOCS &', labelBottom: 'FILMS' },
  { icon: '/music.svg', label: 'MUSIC' },
  { icon: '/courses.svg', label: 'COURSES' },
  { icon: '/shop.svg', label: 'SHOP' },
];
---

<section class="offerings">
  <Container>
    <div class="grid">
      {cards.map((card) => (
        <OfferingCard icon={card.icon} label={card.label} labelBottom={card.labelBottom} />
      ))}
    </div>
  </Container>
</section>

<style>
  .offerings {
    padding-block: var(--space-section);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }
</style>
