---
import Container from '../Container.astro';
import OfferingCard from '../OfferingCard.astro';

/*
  Same left-to-right order as the nav (Navigation.astro's `links`) — Events,
  Series, Docs & Films, Music, Courses, Shop. Card copy is just each name for
  now, plus a reserved (currently unfilled) `description` slot per card — see
  OfferingCard.astro's header comment. The neon palette is still the next pass.
*/
const cards = [
  {
    icon: '/events.svg',
    label: 'EVENTS',
    description: 'High vibrational in-person events and 5D parties to connect with other awakened souls',
  },
  {
    icon: '/series.svg',
    label: 'SERIES',
    description: 'An ongoing collection of the most truth-seeking content from your favorite New Earth celebrities',
  },
  {
    icon: '/docsfilms.svg',
    label: 'DOCS &',
    labelBottom: 'FILMS',
    description: "Cinematic non-fiction and fiction titles that tell stories that Hollywood won't",
  },
  {
    icon: '/music.svg',
    label: 'MUSIC',
    description: 'Albums of all genres and sound healing frequencies that elevate your mind, body, & soul',
  },
  {
    icon: '/courses.svg',
    label: 'COURSES',
    description: 'Online & in-person classes that teach wisdom & gifts that traditional schools hide and censor',
  },
  {
    icon: '/shop.svg',
    label: 'SHOP',
    description: 'Clothing and outfits that allow you to dress like you are already a citizen of the New Earth',
  },
];
---

<section class="offerings">
  <Container>
    <div class="grid">
      {cards.map((card) => (
        <OfferingCard
          icon={card.icon}
          label={card.label}
          labelBottom={card.labelBottom}
          description={card.description}
        />
      ))}
    </div>
  </Container>
</section>

<style>
  .offerings {
    padding-block: var(--space-section);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }
</style>
