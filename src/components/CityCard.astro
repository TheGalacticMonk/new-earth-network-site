---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  city: CollectionEntry<'cities'>;
}

const { city } = Astro.props;
const { name, country, region, summary, image, imageAlt, status } = city.data;
const href = `/cities/${city.id}`;
---

<a class="card" href={href}>
  <div class="media">
    {image ? (
      <Image src={image} alt={imageAlt ?? ''} width={420} height={280} loading="lazy" />
    ) : (
      <div class="placeholder" aria-hidden="true"></div>
    )}
    {status === 'launching' && <span class="badge">Launching</span>}
  </div>
  <div class="body">
    <h3 class="name">{name}</h3>
    <p class="location">{region ? `${region}, ${country}` : country}</p>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: clip;
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-float);
    transition: box-shadow var(--duration-slow) var(--ease-out), transform var(--duration-slow) var(--ease-out);
  }

  .card:hover {
    box-shadow: var(--shadow-float-hover);
    transform: translateY(-4px);
  }

  .media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--color-bg-deep);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(120% 140% at 80% 100%, var(--color-nebula-orchid-soft), transparent 60%), var(--color-bg-deep);
  }

  .badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-bg-deep);
    background: var(--color-electric-cyan);
    border-radius: var(--radius-full);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
  }

  .name {
    font-size: var(--text-md);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card:hover .name {
    color: var(--color-electric-cyan);
  }

  .location {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .summary {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
