---
import Container from './Container.astro';
import Logo from './Logo.astro';

// Kept identical to Navigation.astro's own `links` array on purpose — the
// site owner asked for the footer's Explore column to match the top nav
// exactly, so this isn't independently maintained IA, it's a mirror of it.
// Updated alongside Navigation.astro's move to in-page section anchors
// (2026-09-11): the old catalog routes these used to point at (series.astro,
// docs-films.astro, music.astro, courses.astro, shop.astro) are deleted, not
// just unlinked — keeping this list in sync with the nav is what makes that
// safe.
const explore = [
  { label: 'Offerings', href: '/#offerings' },
  { label: 'Model', href: '/#model' },
  { label: 'Vibe', href: '/#vibe' },
  { label: 'Plan', href: '/#plan' },
  { label: 'Roster', href: '/#roster' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container>
    <div class="row">
      <div class="brand-col">
        <a href="/" aria-label="New Earth Network — home">
          <Logo variant="full" />
        </a>
        <p class="tagline">The complete multidimensional experience, online and offline.</p>
      </div>

      <nav aria-label="Explore">
        <p class="col-heading">Explore</p>
        <ul role="list">
          {explore.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} New Earth Network</p>
      <p class="signature">The internet found us. Now we meet.</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--gradient-veil-top);
    padding-block: var(--space-16) var(--space-8);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .brand-col :global(img) {
    height: var(--footer-logo-height);
    width: auto;
  }

  .tagline {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 32ch;
  }

  .col-heading {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  nav a {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    color: var(--color-electric-cyan);
  }

  .bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .signature {
    font-family: var(--font-display);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .row {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
