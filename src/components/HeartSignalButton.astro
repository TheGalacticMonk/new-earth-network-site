---
// Nav CTA: structurally identical to the site's primary button (pill shape, solid
// electric cyan, dark text, shadow + lift on hover, no border) — the borrowed
// template's sharp corners, bold colored outline, white/cyan flash-fill, and bounce
// animation behaved like nothing else on the site and read as bolted-on rather than
// designed. The one thing kept from the original idea is the heart-burst on hover,
// since it echoes the logo's own heart-hands mark; everything around it now matches
// the same restrained, shadow-based language as every other button here.
interface Props {
  href: string;
}

const { href } = Astro.props;

const heartPath =
  'M427.313,88.686c-47.803-47.803-125.213-47.803-173.016,0l-17.087,17.087l-17.087-17.087' +
  'c-47.803-47.803-125.213-47.803-173.016,0c-47.803,47.803-47.803,125.213,0,173.016l190.103,190.103' +
  'c4.88,4.88,11.316,7.322,17.752,7.322c6.435,0,13.871-2.442,18.751-7.322l190.103-190.103' +
  'C475.116,213.899,475.116,136.489,427.313,88.686z';
---

<a href={href} class="signal-btn">
  <span class="box"><slot /></span>

  <div class="star-1">
    <svg height="32" width="32" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
  <div class="star-2">
    <svg height="20" width="20" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
  <div class="star-3">
    <svg height="9" width="9" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
  <div class="star-4">
    <svg height="12" width="12" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
  <div class="star-5">
    <svg height="20" width="20" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
  <div class="star-6">
    <svg height="9" width="9" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <path d={heartPath} fill="currentColor"></path>
    </svg>
  </div>
</a>

<style>
  .signal-btn {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
    /* Exact same typography as the nav menu items next to it — same family,
       size, and weight, no bolding or extra tracking of its own. */
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
    /* Plum fill with a gold ring — the one deliberate exception to the site's
       borderless surfaces, matching the reference gold CTA this button is
       modeled on for this specific button only. */
    border: 2px solid var(--color-electric-gold);
    box-shadow: var(--shadow-float), 0 0 28px var(--color-electric-gold-glow);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .signal-btn:hover {
    box-shadow:
      var(--shadow-float-hover),
      0 0 12px var(--color-electric-gold),
      0 0 64px var(--color-electric-gold-glow);
    transform: translateY(-1px);
  }

  .signal-btn .box {
    text-align: center;
    width: 100%;
    /* Same padding as the site's standard "md" button — the nav CTA doesn't need
       to be bigger than any other button to read as the important one; the gold
       ring and glow already do that job. */
    padding: var(--space-3) var(--space-6);
    color: var(--color-text-primary);
    position: relative;
    z-index: 20;
  }

  /*
    Hearts are transparent at rest, not camouflaged by a matching fill color — a
    same-color heart still shows through the transparent gaps between letterforms
    wherever it overlaps the text, regardless of z-index. Opacity: 0 hides them
    unconditionally, then they fade in as they fly outward on hover.
  */
  .star-1,
  .star-2,
  .star-3,
  .star-4,
  .star-5,
  .star-6 {
    position: absolute;
    height: auto;
    opacity: 0;
    color: var(--color-heart-pink);
    filter: drop-shadow(0 0 0 currentColor);
    transition:
      opacity 0.5s var(--ease-out),
      top 0.5s var(--ease-out),
      left 0.5s var(--ease-out);
  }

  .signal-btn:hover .star-1,
  .signal-btn:hover .star-2,
  .signal-btn:hover .star-3,
  .signal-btn:hover .star-4,
  .signal-btn:hover .star-5,
  .signal-btn:hover .star-6 {
    opacity: 0.82;
    filter: drop-shadow(0 0 8px currentColor);
  }

  /* Resting positions sit just inside the text band (invisible, opacity: 0) so the
     hover transition has somewhere to grow from; hover positions stay in the
     corners, clear of the 25%–75% band centered text always occupies. */
  .star-1 {
    top: 30%;
    left: 15%;
    width: 20px;
  }
  .signal-btn:hover .star-1 {
    top: -22%;
    left: 2%;
    width: 32px;
  }

  .star-2 {
    top: 60%;
    left: 80%;
    width: 12px;
  }
  .signal-btn:hover .star-2 {
    top: 90%;
    left: 96%;
    width: 20px;
  }

  .star-3 {
    top: 20%;
    left: 60%;
    width: 6px;
  }
  .signal-btn:hover .star-3 {
    top: -18%;
    left: 55%;
    width: 9px;
  }

  .star-4 {
    top: 70%;
    left: 30%;
    width: 8px;
  }
  .signal-btn:hover .star-4 {
    top: 96%;
    left: 22%;
    width: 12px;
  }

  .star-5 {
    top: 40%;
    left: 90%;
    width: 12px;
  }
  .signal-btn:hover .star-5 {
    top: 20%;
    left: 100%;
    width: 20px;
  }

  .star-6 {
    top: 15%;
    left: 40%;
    width: 6px;
  }
  .signal-btn:hover .star-6 {
    top: -14%;
    left: 40%;
    width: 9px;
  }
</style>
