---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  narrow?: boolean;
}

const { as: Tag = 'div', narrow = false } = Astro.props;
---

<Tag class="container" class:list={{ narrow }}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  .narrow {
    max-width: 760px;
  }
</style>
